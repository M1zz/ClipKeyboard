        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ lưu nháp cụm từ khi bạn thực sự có thay đổi, không còn dồn nháp khi chỉ mở xem"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有真的改动过的短语才会存草稿，不再是打开看看就堆一堆"
