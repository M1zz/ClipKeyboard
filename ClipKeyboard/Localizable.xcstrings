    "App will split the text and let you review each memo before saving." : {
      "comment" : "Bulk import: paste footer",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace text rozdělí a před uložením si můžete každou frázi zkontrolovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen deler teksten op, så du kan gennemgå hver frase, før du gemmer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Text wird automatisch aufgeteilt. Du kannst jeden Textbaustein vor dem Sichern prüfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εφαρμογή χωρίζει το κείμενο και μπορείτε να ελέγξετε κάθε φράση πριν από την αποθήκευση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App will split the text and let you review each snippet before saving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app dividirá el texto y podrás revisar cada frase antes de guardar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovellus jakaa tekstin, ja voit tarkistaa jokaisen fraasin ennen tallennusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le texte est découpé automatiquement, et vous pouvez vérifier chaque phrase avant d'enregistrer."
          }
        },
        "id" : {
          "stringUnit" : {
