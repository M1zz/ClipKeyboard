          "stringUnit" : {
            "state" : "translated",
            "value" : "Plochý, jednoduchý vzhled. Karty jemně pruží."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flad og enkel. Kortene giver blødt efter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlicht und flach. Karten geben weich nach."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απλή βασική εμφάνιση. Οι κάρτες ανταποκρίνονται απαλά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flat and plain. Cards respond with a soft bounce."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es el estilo básico y plano. Las tarjetas responden con un rebote suave."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasainen perusilme. Kortit joustavat pehmeästi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un aspect plat et simple. Les cartes réagissent avec douceur."
          }
        },
