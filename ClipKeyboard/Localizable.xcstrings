          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Анонимная диагностика от MetricKit. Включает только стек вызовов, версию приложения и ОС: без личных данных."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อมูลวินิจฉัยแบบไม่ระบุตัวตนจาก MetricKit ประกอบด้วยเฉพาะ call stack เวอร์ชันแอป และ OS ไม่มีข้อมูลผู้ใช้"
