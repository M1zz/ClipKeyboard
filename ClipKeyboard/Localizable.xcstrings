        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohje tulee uudelleen, kunnes näppäimistön käyttöönotto on varmistettu. Pelkkä sulkeminen ei riitä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
