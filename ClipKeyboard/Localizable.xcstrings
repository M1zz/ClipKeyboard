          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oranye yang dulu dipakai. Pilih ini agar tetap seperti semula."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'arancione usato prima. Scegli questo per lasciare tutto com'era."
