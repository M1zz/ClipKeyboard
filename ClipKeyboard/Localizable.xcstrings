    "차분한 파랑이에요. 갈래 칩의 파랑과 나란히 서니 헷갈릴 수 있어요." : {
      "comment" : "Key color note: indigo",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klidná modrá. Vedle modré u štítků témat se může snadno splést."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En rolig blå. Ved siden af de blå kategorichips kan de to flyde sammen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein ruhiges Blau. Neben dem Blau der Kategorie-Chips können beide leicht verschwimmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα ήρεμο μπλε. Δίπλα στο μπλε των ετικετών κατηγορίας, τα δύο μπορεί να μπερδευτούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A calm blue. It sits next to the blue category chips, so the two can blur together."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es un azul tranquilo. Junto al azul de las etiquetas de categoría, pueden confundirse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rauhallinen sininen. Se on teemasirujen sinisen vieressä, joten ne voivat sekoittua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bleu calme. Placé à côté des pastilles de catégorie bleues, les deux peuvent se confondre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biru yang tenang. Warnanya bersebelahan dengan chip biru kategori, jadi keduanya bisa tampak menyatu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un blu tenue. Accanto al blu dei chip delle categorie, i due possono confondersi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "落ち着いた青です。カテゴリのチップの青と並ぶと、見分けにくいことがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "차분한 파랑이에요. 갈래 칩의 파랑과 나란히 서니 헷갈릴 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En rolig blå. Den står ved siden av de blå kategorichipsene, så de kan flyte sammen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een rustig blauw. Naast het blauw van de themachips kan het door elkaar lopen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spokojny niebieski. Obok niebieskich chipów tematów oba kolory mogą się zlewać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um azul calmo. Fica ao lado do azul dos chips de categoria, então os dois podem se confundir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спокойный синий. Рядом с синими чипами категорий его легко перепутать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett lugnt blått. Det ligger bredvid de blå kategorichipsen, så de kan flyta ihop."
