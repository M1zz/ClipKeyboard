    "길게 눌러 선택하고, 복사하고, 돌아와서 붙여넣던 손놀림이에요." : {
      "comment" : "Grounds note: handling",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dlouze stisknout pro výběr, zkopírovat, vrátit se a vložit. Celá ta rutina."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold nede for at markere, kopiere, gå tilbage og indsætte. Hele den rutine."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gedrückt halten zum Auswählen, kopieren, zurückkommen, einfügen. Genau dieser Ablauf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παρατεταμένο πάτημα για επιλογή, αντιγραφή, επιστροφή και επικόλληση. Όλη αυτή η διαδικασία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long-pressing to select, copying, coming back, pasting. That whole routine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantener presionado para seleccionar, copiar, volver y pegar. Todo ese trámite."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitkä painallus, valinta, kopiointi, takaisin ja liittäminen. Sama vanha rutiini."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyer longuement pour sélectionner, copier, revenir, coller. Toujours le même enchaînement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menekan lama untuk memilih, menyalin, kembali, lalu menempel. Rutinitas itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenere premuto per selezionare, copiare, tornare indietro e incollare. Tutta quella trafila."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長押しで選んでコピーして、戻って貼り付ける。その手間のことです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykke og holde for å markere, kopiere, gå tilbake og lime inn. Hele den runden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lang indrukken om te selecteren, te kopiëren, terug te gaan en te plakken. Die hele routine."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymanie, żeby zaznaczyć, skopiować, wrócić i wkleić. Cały ten rytuał."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecionar com um toque longo, copiar, voltar e colar. Toda essa rotina."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Долгое нажатие, чтобы выделить, копирование, переход обратно, вставка. Вся эта рутина."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det var att hålla nedtryckt för att markera, kopiera, gå tillbaka och klistra in. Hela den rundan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กดค้างเพื่อเลือก คัดลอก กลับมาวาง เป็นขั้นตอนที่คุ้นเคยกันดี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basılı tutup seçmek, kopyalamak, geri dönüp yapıştırmak. Hep bu alışkanlık."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn giữ để chọn, sao chép, quay lại rồi dán. Đúng là thao tác quen thuộc đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按选中、复制、再回来粘贴，就是这一整套动作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長按選中、複製、再回來貼上，就是這一整套動作。"
          }
        }
      }
    },
