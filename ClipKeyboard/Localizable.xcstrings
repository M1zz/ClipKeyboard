        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στις Ρυθμίσεις προστέθηκε η ενότητα «Εφαρμογές που συνεργάζονται», όπου οι εφαρμογές που αξίζει να συνδυάσετε παρουσιάζονται μέσα από καθημερινές σκηνές"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
