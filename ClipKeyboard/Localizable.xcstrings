    "시각·운동·청각 보조 기능을 함께 지원합니다. 아래 기능들은 iPhone 설정 → 손쉬운 사용에서 켤 수 있습니다." : {
      "comment" : "Accessibility guide hero description",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podporujeme pomocné funkce pro zrak, motoriku i sluch. Zapnout je můžete v Nastavení iPhone → Zpřístupnění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Understøtter hjælpefunktioner til syn, motorik og hørelse. De kan slås til i iPhone Indstillinger → Tilgængelighed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hilfen für Sehen, Motorik und Hören werden unterstützt. Du kannst sie in den iPhone-Einstellungen unter Bedienungshilfen aktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υποστηρίζονται λειτουργίες βοήθειας για την όραση, την κίνηση και την ακοή. Μπορείτε να τις ενεργοποιήσετε στις Ρυθμίσεις του iPhone → Προσβασιμότητα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supports visual, motor, and auditory assistive features. These can be enabled in iPhone Settings → Accessibility."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compatible con funciones de accesibilidad visual, motriz y auditiva. Puedes activarlas en Ajustes de iPhone → Accesibilidad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuemme näkö-, liikkumis- ja kuuloapuominaisuuksia. Voit ottaa ne käyttöön iPhonen Asetuksissa → Saavutettavuus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fonctions d'accessibilité visuelles, motrices et auditives sont prises en charge. Vous pouvez les activer dans Réglages → Accessibilité sur iPhone."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mendukung fitur bantuan visual, motorik, dan pendengaran. Fitur ini bisa diaktifkan di Pengaturan → Aksesibilitas iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono supportate funzioni di assistenza per vista, motricità e udito. Puoi attivarle in Impostazioni di iPhone → Accessibilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視覚・運動・聴覚の補助機能に対応しています。以下の機能は、iPhoneの設定 → アクセシビリティでオンにできます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Støtter hjelpemidler for syn, motorikk og hørsel. Du kan slå dem på i Innstillinger → Tilgjengelighet på iPhone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ondersteunt visuele, motorische en auditieve hulpmiddelen. Je zet ze aan in Instellingen → Toegankelijkheid op je iPhone."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obsługuje funkcje ułatwień dla wzroku, ruchu i słuchu. Włączysz je w Ustawienia iPhone → Dostępność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Há suporte a recursos de acessibilidade visual, motora e auditiva. Você pode ativá-los em Ajustes do iPhone → Acessibilidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поддерживает вспомогательные функции для зрения, движения и слуха. Их можно включить в Настройках iPhone → Универсальный доступ."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stöd finns för hjälpmedel för syn, motorik och hörsel. Du slår på dem i iPhone Inställningar → Hjälpmedel."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รองรับฟีเจอร์ช่วยการเข้าถึงทั้งด้านการมองเห็น การเคลื่อนไหว และการได้ยิน เปิดได้ที่ การตั้งค่า → การเข้าถึง ใน iPhone"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görsel, motor ve işitsel erişilebilirlik özelliklerini destekler. Aşağıdakileri iPhone Ayarlar → Erişilebilirlik bölümünden açabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng hỗ trợ các tính năng trợ năng cho thị giác, vận động và thính giác. Bạn có thể bật chúng trong Cài đặt của iPhone → Trợ năng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同时支持视觉、行动和听觉方面的辅助功能。下面这些可以在 iPhone 的“设置 → 辅助功能”里打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同時支援視覺、行動和聽覺方面的輔助使用。下面這些可以在 iPhone 的「設定 → 輔助使用」裡開啟。"
          }
        }
      }
    },
