            "value" : "เก็บไว้เป็นบันทึกการใช้งาน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Được lưu lại trong lịch sử dùng"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
