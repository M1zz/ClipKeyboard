          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controllo vocale: di' \"Tocca Cerca frasi\" o \"Tocca OK\" → verifica la risposta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
