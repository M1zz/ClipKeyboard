    "⚠️ 복구 시 현재 데이터가 백업 데이터로 교체됩니다" : {
      "comment" : "Auto-registered",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Obnovením se současná data nahradí zálohou"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Gendannelse erstatter dine nuværende data med backuppen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Beim Wiederherstellen werden deine aktuellen Daten durch das Backup ersetzt"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Η επαναφορά αντικαθιστά τα τρέχοντα δεδομένα με το αντίγραφο"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Restoring replaces your current data with the backup"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Al restaurar, tus datos actuales se reemplazan por los del respaldo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Palautus korvaa nykyiset tiedot varmuuskopiolla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ La restauration remplace vos données actuelles par la sauvegarde"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Pemulihan mengganti data Anda saat ini dengan data cadangan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Il ripristino sostituisce i dati attuali con il backup"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
