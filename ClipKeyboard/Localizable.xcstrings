        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "페르소나를 처음이 아니라 써 보고 나서 여쭤봐요. 단축어를 두 개 만드셨거나 카테고리를 하나 만드셨을 때 한 번만요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi spør om persona etter at du har brukt appen, ikke på første skjerm. Bare én gang, etter to fraser eller én kategori"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We vragen naar je persona nadat je de app hebt gebruikt, niet op het eerste scherm. Eenmalig, na twee fragmenten of één thema"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapytamy o personę dopiero po tym, jak wypróbujesz aplikację, a nie na pierwszym ekranie. Tylko raz: po dwóch frazach lub jednym temacie"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perguntamos sobre o seu perfil depois que você já usou o app, não na primeira tela. Só uma vez, depois de duas frases ou um tema"
