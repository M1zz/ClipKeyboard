    "Hi team, wifi at my co-working just dropped. Back online now from a backup spot. Ready to continue whenever you are.": {
      "comment": "Example — wifi",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi team, wifi at my co-working just dropped. Back online now from a backup spot. Ready to continue whenever you are."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팀 여러분, 코워킹 와이파이가 끊겼다가 백업 장소에서 다시 연결됐습니다. 언제든 이어가실 수 있도록 준비되어 있습니다."
          }
        }
      }
    },
    "Hi {client_name}, I noticed you're hiring for {role}. I've worked on similar projects for {reference} — here's a quick overview: {portfolio}. Open to a 15-min chat?": {
      "comment": "Example — upwork proposal",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi {client_name}, I noticed you're hiring for {role}. I've worked on similar projects for {reference} — here's a quick overview: {portfolio}. Open to a 15-min chat?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안녕하세요 {client_name}님, {role} 포지션 채용 중이신 것을 보았습니다. {reference}에서 비슷한 프로젝트를 진행한 경험이 있으며 — 간단한 포트폴리오: {portfolio}. 15분 정도 짧은 대화 가능할까요?"
          }
        }
      }
    },
    "Hi {client}, I'm in GMT+{offset} right now ({city}). I can do {time_window}. Calendly: {link}": {
      "comment": "Example — timezone reply",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi {client}, I'm in GMT+{offset} right now ({city}). I can do {time_window}. Calendly: {link}"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안녕하세요 {client}님, 저는 현재 GMT+{offset} ({city})에 있습니다. {time_window} 가능합니다. Calendly: {link}"
          }
        }
      }
    },
    "Hi {client}, giving you a heads-up — {reason}, so I'm pushing the delivery to {new_date}. I'll send a progress preview tomorrow so you're not left in the dark.": {
      "comment": "Example — delay",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi {client}, giving you a heads-up — {reason}, so I'm pushing the delivery to {new_date}. I'll send a progress preview tomorrow so you're not left in the dark."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안녕하세요 {client}님, 미리 알려드립니다 — {reason}으로 인해 납기를 {new_date}로 연기합니다. 진행 상황은 내일 미리 보여드려 답답하지 않도록 하겠습니다."
          }
        }
      }
    },
    "Hi {client}, happy to take this on — it falls outside our original scope ({original_scope}), so I'll send an updated quote for this add-on. Does that work?": {
      "comment": "Example — scope pushback",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi {client}, happy to take this on — it falls outside our original scope ({original_scope}), so I'll send an updated quote for this add-on. Does that work?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안녕하세요 {client}님, 기꺼이 도와드리겠습니다 — 다만 원래 스코프({original_scope})를 벗어나는 작업이라 업데이트된 견적을 보내드리겠습니다. 괜찮을까요?"
          }
        }
      }
    },
    "Hi {client}, if you enjoyed working together, a short testimonial (2–3 sentences) for my site would mean a lot. No pressure at all — only if it's easy.": {
      "comment": "Example — testimonial",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi {client}, if you enjoyed working together, a short testimonial (2–3 sentences) for my site would mean a lot. No pressure at all — only if it's easy."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안녕하세요 {client}님, 함께 작업한 경험이 좋으셨다면 제 사이트에 올릴 짧은 추천사(2-3문장) 부탁드려도 될까요. 부담 가지지 마시고 — 간단히 가능하실 때만요."
          }
        }
      }
    },
    "Hi {client}, just a kind reminder about invoice #{invoice_no} (due {due_date}, now {days} days overdue). Let me know if there's any issue on your end — happy to help resolve.": {
