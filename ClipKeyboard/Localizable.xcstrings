    "시작하다 문제가 생겨도 다음 실행은 열려요" : {
      "comment" : "Changelog 4.4.6 item 2",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když se při spuštění něco pokazí, další spuštění se otevře"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opstår der en fejl ved start, åbner næste opstart stadig"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn beim Start etwas schiefgeht, öffnet sich der nächste Start trotzdem"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν κάτι πάει στραβά κατά την εκκίνηση, η επόμενη εκκίνηση ανοίγει κανονικά"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If something fails at startup, the next launch still opens"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si algo falla al iniciar, la siguiente vez la app abre igual"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos käynnistyksessä tulee virhe, seuraava käynnistys silti avautuu"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cas de problème au démarrage, le lancement suivant s'ouvre quand même"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika ada masalah saat memulai, peluncuran berikutnya tetap terbuka"
