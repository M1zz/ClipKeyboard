    "더 큰 텍스트: 설정에서 텍스트 크기 최대로 → 앱 단축어 목록에서 텍스트 크기 확인." : {
      "comment" : "Test step: Larger Text",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Větší text: V nastavení zvolte největší velikost textu → v seznamu frází v aplikaci zkontrolujte velikost textu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Større tekst: Sæt tekststørrelsen til maksimum i Indstillinger → tjek tekststørrelsen i appens liste over fraser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Größerer Text: Stell in den Einstellungen die maximale Textgröße ein → prüfe die Textgröße in der Textbaustein-Liste der App."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μεγαλύτερο κείμενο: ορίστε το μέγεθος κειμένου στο μέγιστο στις ρυθμίσεις → ελέγξτε το μέγεθος στη λίστα φράσεων της εφαρμογής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Larger Text: Set text size to maximum in settings → confirm text size in the app snippet list."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texto más grande: pon el tamaño de texto al máximo en Ajustes → revisa el tamaño del texto en la lista de frases de la app."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suurempi teksti: Aseta asetuksissa tekstin koko suurimmaksi → tarkista tekstin koko apin fraasilistasta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texte plus grand : réglez la taille du texte au maximum dans les réglages → vérifiez la taille du texte dans la liste des phrases de l'app."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teks Lebih Besar: atur ukuran teks ke maksimum di pengaturan, lalu periksa ukuran teks di daftar frasa aplikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testo più grande: imposta la dimensione massima del testo nelle impostazioni, poi controlla l'elenco delle frasi nell'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "さらに大きな文字: 設定で文字サイズを最大にして、アプリの定型文リストで文字サイズを確認します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Større tekst: Sett tekststørrelsen til maks i innstillingene → sjekk tekststørrelsen i fraselisten i appen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grotere tekst: zet de tekstgrootte in Instellingen op maximaal → controleer de tekstgrootte in de fragmentenlijst van de app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Większy tekst: ustaw największy rozmiar tekstu w ustawieniach → sprawdź rozmiar tekstu na liście fraz w aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texto maior: defina o tamanho máximo do texto nos Ajustes → confira o tamanho do texto na lista de frases do app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Крупный текст: установите максимальный размер текста в настройках → проверьте размер текста в списке фраз приложения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Större text: Ställ in textstorleken på max i inställningarna → kontrollera textstorleken i appens fraslista."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อความขนาดใหญ่ขึ้น: ตั้งขนาดข้อความเป็นสูงสุดในการตั้งค่า → ตรวจสอบขนาดข้อความในรายการข้อความด่วนของแอป"
