    "따로 고르지 않으셔도 돼요. 단축어가 늘면 판단도 함께 바뀌어요." : {
      "comment" : "Usage profile: inferred, no need to choose",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemusíte nic vybírat. S přibývajícími frázemi se to průběžně mění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du behøver ikke vælge. Når du får flere fraser, opdateres det af sig selv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du musst nichts auswählen. Mit mehr Textbausteinen passt sich das von selbst an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν χρειάζεται να διαλέξετε. Όσο αυξάνονται οι φράσεις σας, αλλάζει και αυτό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No need to choose. As your snippets grow, this updates with them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No necesitas elegir. Si tus frases aumentan, esto se ajusta solo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitsemista ei tarvita. Kun fraasit lisääntyvät, tämä päivittyy itsestään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inutile de choisir. Ce profil évolue à mesure que vos phrases se multiplient."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak perlu memilih. Seiring frasa Anda bertambah, ini ikut menyesuaikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non serve scegliere. Con più frasi, il profilo si aggiorna da solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選ばなくても大丈夫です。定型文が増えると、判定も一緒に変わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "따로 고르지 않으셔도 돼요. 단축어가 늘면 판단도 함께 바뀌어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du trenger ikke velge. Når frasene dine vokser, endres dette med dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hoeft niets te kiezen. Naarmate je meer fragmenten hebt, past dit zich aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie musisz wybierać. Gdy przybędzie fraz, ocena zmieni się razem z nimi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não precisa escolher. Conforme seus snippets aumentam, isso se ajusta junto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбирать ничего не нужно. Это меняется само по мере того, как растёт число ваших фраз."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du behöver inte välja. När dina fraser blir fler justeras det av sig självt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ต้องเลือกเอง เมื่อมีข้อความด่วนมากขึ้น ค่านี้จะปรับตามให้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçim yapmanız gerekmez. İfadeleriniz arttıkça bu da güncellenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn không cần chọn. Khi cụm từ tăng lên, mục này sẽ tự cập nhật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需选择。短语越来越多时，判断也会随之更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無需選擇。短語越來越多時，判斷也會隨之更新。"
          }
        }
      }
    },
    "따로 있던 콤보를 단축어 목록 안으로 들여왔어요" : {
      "comment" : "Changelog 4.3.1 item 3",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komba přesunuta z vlastní obrazovky do seznamu frází"
          }
        },
        "da" : {
