        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι φράσεις σας δεν διαγράφηκαν: το αρχείο αποθήκευσης δεν μπόρεσε να διαβαστεί. Το πρωτότυπο έχει φυλαχθεί."
          }
        },
