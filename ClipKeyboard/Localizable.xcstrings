    "셈을 고치기 전에 쓴 기록도 새 셈으로 보여요. 기간마다 같은 한 번이 다른 금액으로 찍히던 걸 고쳤어요" : {
      "comment" : "Changelog 5.0.1 reprice",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použití zaznamenaná před přepočtem se nyní zobrazují také s novými čísly. Totéž jedno použití už v různých obdobích nevychází s jinou částkou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug registreret før gentællingen vises nu også med de nye tal. Den samme enkelte brug viser ikke længere forskellige beløb i forskellige perioder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch Nutzungen von vor der Neuzählung erscheinen jetzt mit den neuen Werten. Dieselbe einzelne Nutzung wird nicht mehr je nach Zeitraum mit anderem Betrag angezeigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι χρήσεις που καταγράφηκαν πριν τον επανυπολογισμό εμφανίζονται τώρα με τους νέους αριθμούς. Η ίδια μία χρήση δεν εμφανίζει πια διαφορετικό ποσό σε διαφορετικές περιόδους."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses recorded before the recount now show the new numbers too. The same single use no longer prints a different amount on different periods."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los usos registrados antes del nuevo conteo ahora también se ven con los números nuevos. Corregimos que un mismo uso aparecía con distinto monto según el periodo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aiemmin tehdyt käyttökerrat näkyvät nyt uusilla luvuilla. Sama yksittäinen käyttökerta ei enää näy eri summalla eri jaksoilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les utilisations enregistrées avant le recalcul s'affichent aussi avec les nouveaux chiffres. Une même utilisation n'apparaît plus avec un montant différent selon la période."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemakaian yang tercatat sebelum penghitungan ulang kini tampil dengan angka baru. Satu pemakaian yang sama tidak lagi menghasilkan jumlah berbeda di tiap periode."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche gli usi registrati prima del nuovo conteggio ora mostrano i nuovi valori. Lo stesso singolo uso non appare più con importi diversi a seconda del periodo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計算を直す前の記録も、新しい計算で表示されます。期間によって同じ1回が違う金額で記録されていた問題を直しました"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk registrert før omtellingen vises nå også med de nye tallene. Samme enkeltbruk får ikke lenger ulikt beløp i ulike perioder"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik van vóór de herberekening toont nu ook de nieuwe aantallen. Hetzelfde enkele gebruik toonde per periode een ander bedrag, dat is opgelost."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użycia zapisane przed poprawką liczenia też pokazują nowe wartości. Jedno użycie nie ma już różnych kwot w różnych okresach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os usos registrados antes da nova contagem agora aparecem com os números novos. O mesmo uso não aparece mais com valores diferentes em cada período."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записи до пересчёта тоже теперь показывают новые цифры. Одно и то же использование больше не считается по-разному в разные периоды."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Användningar som registrerades före omräkningen visas nu också med de nya siffrorna. Samma enskilda användning visar inte längre olika belopp för olika perioder."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกการใช้ก่อนการนับใหม่จะแสดงตามตัวเลขใหม่ด้วย การใช้ครั้งเดียวกันไม่แสดงจำนวนต่างกันในแต่ละช่วงเวลาอีกแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeniden sayımdan önce kaydedilen kullanımlar da artık yeni sayılarla görünür. Aynı tek kullanımın farklı dönemlerde farklı tutarla yazılması düzeltildi"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các lần dùng ghi trước khi tính lại giờ cũng hiển thị theo số mới. Đã sửa lỗi cùng một lần dùng bị tính số tiền khác nhau ở từng khoảng thời gian"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "改算法之前记录的使用，也会按新算法显示。修好了同一次使用在不同时间段显示成不同金额的问题"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "改演算法之前記錄的使用，也會按新演算法顯示。修好了同一次使用在不同時間段顯示成不同金額的問題"
          }
        }
      }
    },
    "셋을 눌러 본 뒤에는 직접 하나 만들어 보는 걸음으로 이어져요" : {
      "comment" : "Changelog 5.0.0 make own",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po vyzkoušení všech tří vytvoříte vlastní"
