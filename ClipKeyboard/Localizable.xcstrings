    "일·주·월·연 단위로 묶어서 보여줘요. 차트를 좌우로 넘기면 그 단위만큼 과거로 이동하고, 막대를 탭하면 그 기간의 정확한 날짜와 숫자가 나와요." : {
      "comment" : "Usage stats trend footer",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seskupeno podle dne, týdne, měsíce nebo roku. Přejetím po grafu se posunete v čase zpět a klepnutím na sloupec zobrazíte přesné datum a číslo daného období."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupperet efter dag, uge, måned eller år. Stryg i diagrammet for at gå tilbage i tiden, og tryk på en søjle for at se periodens præcise dato og tal."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach Tag, Woche, Monat oder Jahr gruppiert. Wische im Diagramm, um in der Zeit zurückzugehen, und tippe auf einen Balken, um das genaue Datum und die Zahl des Zeitraums zu sehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η προβολή ομαδοποιείται ανά ημέρα, εβδομάδα, μήνα ή έτος. Σύρετε το γράφημα για να πάτε πίσω στον χρόνο και πατήστε μια μπάρα για να δείτε την ακριβή ημερομηνία και τον αριθμό της περιόδου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grouped by day, week, month, or year. Swipe the chart to move back in time, and tap a bar to see that period's exact date and number."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se agrupa por día, semana, mes o año. Desliza la gráfica hacia los lados para ir atrás en el tiempo y toca una barra para ver la fecha exacta y la cifra de ese periodo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ryhmittely päivän, viikon, kuukauden tai vuoden mukaan. Selaa kaaviota sivuttain siirtyäksesi ajassa taaksepäin ja napauta palkkia nähdäksesi jakson tarkan päivämäärän ja luvun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regroupé par jour, semaine, mois ou année. Faites glisser le graphique pour remonter dans le temps, et touchez une barre pour voir la date exacte et le nombre de cette période."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dikelompokkan per hari, minggu, bulan, atau tahun. Geser grafik untuk mundur sebanyak satuan itu, dan ketuk batang untuk melihat tanggal dan angka persisnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raggruppati per giorno, settimana, mese o anno. Scorri il grafico per tornare indietro nel tempo e tocca una barra per vedere data e numero esatti di quel periodo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日・週・月・年ごとにまとめて表示します。チャートを左右にスワイプするとその単位ぶん過去に移動し、棒をタップするとその期間の正確な日付と数が表示されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gruppert etter dag, uke, måned eller år. Sveip i diagrammet for å gå tilbake i tid, og trykk på en søyle for å se nøyaktig dato og tall for perioden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gegroepeerd per dag, week, maand of jaar. Veeg door de grafiek om terug in de tijd te gaan en tik op een balk voor de exacte datum en het exacte aantal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupowane według dnia, tygodnia, miesiąca lub roku. Przesuń wykres, aby cofnąć się w czasie, a stuknij słupek, aby zobaczyć dokładną datę i liczbę z tego okresu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrupado por dia, semana, mês ou ano. Deslize o gráfico para voltar no tempo e toque em uma barra para ver a data e o número exatos daquele período."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Группировка по дням, неделям, месяцам или годам. Пролистайте график, чтобы вернуться назад во времени, и нажмите на столбец, чтобы увидеть точную дату и число за этот период."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupperat per dag, vecka, månad eller år. Svep i diagrammet för att gå bakåt i tiden och tryck på en stapel för att se exakt datum och antal för perioden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จัดกลุ่มตามวัน สัปดาห์ เดือน หรือปี เลื่อนแผนภูมิไปทางซ้ายหรือขวาเพื่อย้อนดูช่วงก่อนหน้า แตะแท่งเพื่อดูวันที่และตัวเลขที่แน่นอนของช่วงนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gün, hafta, ay ve yıl olarak gruplanır. Grafiği kaydırarak geçmişe gidebilir, bir çubuğa dokunarak o dönemin tam tarihini ve sayısını görebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhóm theo ngày, tuần, tháng hoặc năm. Vuốt biểu đồ sang trái phải để xem lại quá khứ, chạm vào một cột để xem ngày và số chính xác của kỳ đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按日、周、月、年分组显示。左右滑动图表可以按这个单位往前翻，点一下柱子会显示那段时间的具体日期和数字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按日、周、月、年分組顯示。左右滑動圖表可以按這個單位往前翻，點一下柱子會顯示那段時間的具體日期和數字。"
          }
        }
      }
    },
    "일·주·월·연 단위로 묶어서 보여줘요. 차트를 좌우로 넘기면 그 단위만큼 과거로 이동합니다." : {
      "comment" : "Usage stats trend footer",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grouped by day, week, month or year. Swipe the chart sideways to move back one unit at a time."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按日、周、月、年分组显示。左右滑动图表可以按这个单位往前翻。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按日、周、月、年分組顯示。左右滑動圖表可以按這個單位往前翻。"
          }
        }
      },
      "shouldTranslate" : false
    },
