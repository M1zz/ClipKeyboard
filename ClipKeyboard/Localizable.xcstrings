          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utwórz jeszcze kilka fraz, a najpierw pokażemy przykłady i funkcje, które do Ciebie pasują. Do tego czasu zobaczysz te, które pasują wszystkim."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie mais algumas frases e mostraremos primeiro exemplos e recursos que combinam com você. Até lá, você verá o que serve para todo mundo."
