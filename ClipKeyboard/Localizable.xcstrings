      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit VoiceOver öffnet sich das Menü nicht per Tippen mit zwei Fingern, denn diese Geste stoppt schon das Vorlesen"
