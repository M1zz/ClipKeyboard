        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Черновики сохраняются только при реальных изменениях: больше не копятся просто от открытия."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกร่างเฉพาะข้อความด่วนที่แก้ไขจริง ไม่มีร่างค้างสะสมอีก"
