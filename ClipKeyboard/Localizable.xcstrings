    "최근 단축어는 단축어가 늘어나면 저절로 켜집니다. 한 번 직접 켜거나 끄시면 그대로 둡니다." : {
      "comment" : "Recent snippets auto default footer",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedávné fráze se zapnou samy, jakmile jich přibude. Pokud je zapnete nebo vypnete sami, zůstane to tak."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seneste fraser slås til af sig selv, når du får flere fraser. Slår du det til eller fra selv, bliver det, som du valgte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letzte Textbausteine schaltet sich von selbst ein, sobald du mehr Textbausteine hast. Wenn du es einmal selbst ein- oder ausschaltest, bleibt es so."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι πρόσφατες φράσεις ενεργοποιούνται μόνες τους όσο προσθέτετε φράσεις. Αν το αλλάξετε εσείς, η επιλογή σας μένει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recent snippets turns on by itself as you add more. Once you switch it yourself, your choice stays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frases recientes se activa solo cuando tienes más frases. Si lo cambias tú, se queda como lo dejes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viimeisimmät fraasit kytkeytyvät itsestään päälle, kun fraaseja kertyy. Jos muutat asetusta itse, valintasi pysyy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les phrases récentes s'activent d'elles-mêmes quand vous en ajoutez davantage. Si vous les activez ou désactivez vous-même, votre choix est conservé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frasa terbaru menyala sendiri saat frasa Anda bertambah. Jika Anda sudah mengubahnya sendiri, pilihan Anda tetap dipakai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le frasi recenti si attivano da sole quando ne aggiungi altre. Se le attivi o disattivi tu, la scelta resta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近の定型文は、定型文が増えると自動でオンになります。一度手動でオンかオフにすると、その設定のままになります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nylige fraser slås på av seg selv når du får flere fraser. Når du har valgt selv, beholdes valget."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recente fragmenten gaat vanzelf aan als je meer fragmenten toevoegt. Zodra je het zelf aan- of uitzet, blijft je keuze staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostatnie frazy włączą się same, gdy przybędzie fraz. Po ręcznej zmianie ustawienie zostanie bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frases recentes liga sozinho quando você tem mais frases. Se você ligar ou desligar, sua escolha permanece."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недавние фразы включаются сами, когда их становится больше. Если вы один раз включите или выключите это сами, выбор сохранится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senaste fraser slås på av sig självt när du får fler fraser. Ändrar du det själv ligger valet kvar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อความด่วนล่าสุดจะเปิดเองเมื่อคุณมีข้อความด่วนมากขึ้น หากเปิดหรือปิดด้วยตัวเองแล้ว ระบบจะคงค่านั้นไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son ifadeler, ifadeleriniz arttıkça kendiliğinden açılır. Bir kez kendiniz açıp kapatırsanız tercihiniz korunur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cụm từ gần đây tự bật khi bạn có thêm cụm từ. Khi bạn đã tự bật hoặc tắt, lựa chọn đó sẽ được giữ nguyên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短语变多后，最近使用会自动打开。您手动开关过一次后，就按您的选择来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短語變多後，最近使用會自動開啟。您手動開關過一次後，就按您的選擇來。"
          }
        }
      }
    },
