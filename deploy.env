# DeployBar 배포 설정 - 이 파일이 이 앱의 배포 규칙 전부다.
# 참고: DeployBar/README.md 의 "앱 쪽 규칙" 표

# 필수: archive 할 scheme
#
# ⚠️ 이 폴더에는 .xcodeproj 가 둘이다. ClipKeyboard.xcodeproj 와 "Token memo.xcodeproj" 는
#    project.pbxproj 가 바이트까지 같은 사본이고, 둘 다 ClipKeyboard·ClipKeyboardExtension·
#    "Token memo" 세 scheme 을 공유한다. DeployBar 는 폴더에서 먼저 잡히는 .xcodeproj 를
#    고르고 그 이름을 scheme 으로 삼는데, 그러면 어느 쪽이 잡히느냐에 따라 scheme 이
#    "ClipKeyboard" 도 되고 "Token memo" 도 된다. 여기서 못 박아 둔다.
#    (세 scheme 모두 ClipKeyboard.app 을 아카이브하므로 결과물은 같다)
SCHEME=ClipKeyboard

# 플랫폼 (ios | macos). 자동 판별이 맞으면 지워도 된다.
# 멀티플랫폼 타겟은 SDKROOT 만으로 구분되지 않아 명시해 두는 편이 안전하다.
PLATFORM=ios

# 권장: 버전·빌드번호의 단일 소스. 없으면 project.pbxproj 를 직접 고친다(타겟이 여러 개면 위험).
VERSION_XCCONFIG=Version.xcconfig

# 권장: 배포 전 게이트. 실패하면 아카이브를 만들지 않는다.
PREDEPLOY_SCRIPT=scripts/predeploy.sh

# 다국어: App Store 에 등록한 언어. 이 목록이 곧
#   (1) 다국어 게이트의 검사 기준이고
#   (2) 릴리즈노트를 만들 언어다.
#
# ⚠️ 러시아어는 앱에만 있고 App Store 페이지에는 아직 없다. 여기 ru 를 적어 두는 것은
#    "갖출 것" 이라는 선언이다. 스토어에 칸이 없는 동안 배포 로그가
#    "올릴 자리가 없습니다" 라고 일러 주고 러시아어 문구는 버려진다. 그 자리에서
#    말해 주는 편이 조용히 빠지는 것보다 낫다.
#    칸을 만드는 법과 넣을 원고: docs/marketing/APP_STORE_RU.md
LOCALES=ko,en-US,zh-Hans,zh-Hant,ru

# 다국어 게이트 강도
#   strict - 번역 구멍이 하나라도 있으면 배포 중단 (다국어 앱 권장)
#   warn   - 로그에만 남기고 배포는 진행 (기본값)
#   off    - 검사 안 함
#
# warn 인 이유: 이 앱의 진짜 다국어 게이트는 PREDEPLOY_SCRIPT 안의
# `python3 scripts/i18n.py check` 다. 그쪽이 i18n/config.json 의 enabled 를 기준으로 보고,
# i18n/retired.json 의 은퇴한 키(코드에서 사라졌지만 되살아날 수 있어 카탈로그에 남겨 둔 것)를
# 제외한다. DeployBar 의 검사는 그 사정을 모르고 은퇴한 키 400여 개를 미번역으로 세고,
# `한/EN` 처럼 한글이 들어가야 맞는 번역문을 한글 혼입으로 센다. 여기서 막으면 배포가
# 잘못된 이유로 멈춘다. 세는 것은 두되 멈추는 것은 predeploy 에 맡긴다.
LOCALIZATION_GATE=warn

# 릴리즈노트 게이트 - '이 버전의 새로운 기능' 이 비어 있으면
#   strict - 배포 중단 (기본값). 빈 노트로 나간 버전은 되돌릴 수 없다.
#   warn   - 경고만 하고 진행
#   off    - 검사 안 함
RELEASE_NOTES_GATE=strict
