          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แอปเร็วขึ้น ไม่มีอาการค้างตอนเปิดแล้ว และงานใน 10 วินาทีแรกลดลงครึ่งหนึ่ง"
