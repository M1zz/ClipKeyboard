      "shouldTranslate" : false
    },
    "앞 4자리(국가코드+검증번호)를 다시 확인해 주세요. 나머지는 형식이 맞습니다." : {
      "comment" : "Repair hint when IBAN checksum fails",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkontrolujte první 4 znaky (kód země + kontrolní číslice). Zbytek je v pořádku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjek de første 4 tegn (landekode og kontrolciffer). Resten ser rigtigt ud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe die ersten 4 Zeichen (Ländercode + Prüfziffern). Der Rest passt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ελέγξτε ξανά τους πρώτους 4 χαρακτήρες (κωδικός χώρας + ψηφία ελέγχου). Τα υπόλοιπα είναι σωστά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the first 4 characters (country code + check digits). The rest looks right."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa los primeros 4 caracteres (código de país y dígitos de control). El resto tiene el formato correcto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkista 4 ensimmäistä merkkiä (maakoodi + tarkistusluvut). Loput ovat oikein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez les 4 premiers caractères (code pays + clé de contrôle). Le reste est au bon format."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Periksa lagi 4 karakter pertama (kode negara + angka pemeriksa). Sisanya sudah benar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla di nuovo i primi 4 caratteri (codice paese + cifre di controllo). Il resto ha il formato corretto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初の4文字(国コードとチェックデジット)をもう一度確認してください。残りの形式は合っています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjekk de fire første tegnene (landskode + kontrollsiffer). Resten ser riktig ut."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleer de eerste 4 tekens (landcode + controlegetal). De rest lijkt juist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź pierwsze 4 znaki (kod kraju + cyfry kontrolne). Reszta jest w porządku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confira os 4 primeiros caracteres (código do país + dígitos de verificação). O restante está correto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте первые 4 символа (код страны и контрольные цифры). Остальное указано верно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollera de första 4 tecknen (landskod + kontrollsiffror). Resten ser rätt ut."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โปรดตรวจสอบ 4 ตัวแรก (รหัสประเทศ + เลขตรวจสอบ) อีกครั้ง ส่วนที่เหลือรูปแบบถูกต้อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk 4 karakteri (ülke kodu + kontrol basamakları) tekrar kontrol edin. Geri kalanı doğru görünüyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy kiểm tra lại 4 ký tự đầu (mã quốc gia + số kiểm tra). Phần còn lại đúng định dạng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请再确认一下前 4 位（国家代码 + 校验位）。其余部分格式是对的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請再確認一下前 4 位（國家代碼 + 檢查碼）。其餘部分格式是對的。"
          }
        }
      }
    },
    "앞뒤를 남기고 가운데만 줄여요. 앞이 비슷한 이름끼리도 구분돼요." : {
      "comment" : "Key label truncation description: middle",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachová začátek i konec a zkrátí prostředek, takže jména se stejným začátkem zůstanou rozlišitelná."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beholder start og slutning og forkorter midten, så navne med samme begyndelse stadig kan kendes fra hinanden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behält Anfang und Ende und kürzt die Mitte. So bleiben Namen mit ähnlichem Anfang unterscheidbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κρατά την αρχή και το τέλος και συντομεύει τη μέση, ώστε ονόματα με ίδια αρχή να ξεχωρίζουν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps the start and the end, shortening the middle, so names that start alike stay tellable apart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva el inicio y el final, y acorta la parte del medio. Así se distinguen los nombres que empiezan igual."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säilyttää alun ja lopun, lyhentää keskiosan. Samalla alkavat nimet erottuvat toisistaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde le début et la fin, et raccourcit le milieu. Les noms qui commencent pareil restent distincts."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagian awal dan akhir dipertahankan, bagian tengah dipersingkat, sehingga nama yang awalnya mirip tetap bisa dibedakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene l'inizio e la fine e accorcia il centro, così i nomi che iniziano allo stesso modo restano distinguibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前後を残して、真ん中だけ省略します。前半が似た名前でも見分けられます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beholder starten og slutten og forkorter midten, så navn som starter likt fortsatt kan skilles."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behoudt begin en einde en verkort het midden, zodat namen met dezelfde beginletters te onderscheiden blijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zostawia początek i koniec, skracając środek, aby podobne nazwy dało się odróżnić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém o início e o fim e encurta o meio, para diferenciar nomes que começam igual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начало и конец остаются, сокращается середина, поэтому похожие вначале названия легко отличить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behåller början och slutet och kortar ned mitten, så namn som börjar likadant går att skilja åt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เก็บส่วนหัวและส่วนท้ายไว้ ย่อเฉพาะตรงกลาง ชื่อที่ขึ้นต้นคล้ายกันจึงยังแยกออก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baştaki ve sondaki kısmı korur, ortayı kısaltır. Başı benzer olan adlar da ayırt edilebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ phần đầu và phần cuối, rút gọn ở giữa. Các tên có phần đầu giống nhau vẫn phân biệt được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留开头和结尾，只缩短中间，所以开头相似的名字也能分得清。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留開頭和結尾，只縮短中間，所以開頭相似的名字也能分得清。"
          }
        }
      }
    },
