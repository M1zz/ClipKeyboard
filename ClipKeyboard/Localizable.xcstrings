        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cronologia delle copie e il testo salvato dalla tastiera sono in un unico posto. Tocca per inserirlo, tieni premuto per copiarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリが集めたコピー履歴と、キーボードで保存した文章が1か所にまとまります。タップで入力、長押しでコピーします。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
