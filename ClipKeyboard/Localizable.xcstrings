    "두껍고 각진 키. 누르는 맛이 가장 큽니다." : {
      "comment" : "Keyboard skin description: mechanical",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silné, hranaté klávesy. Nejpříjemnější stisk."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tykke, kantede taster. Det mest tilfredsstillende tryk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dicke, eckige Tasten. Das beste Tippgefühl."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χοντρά, γωνιώδη πλήκτρα. Η πιο έντονη αίσθηση πατήματος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thick, squared keys. The most satisfying press."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teclas gruesas y angulares. La pulsación más marcada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paksut, kulmikkaat näppäimet. Napautus tuntuu parhaalta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touches épaisses et angulaires. La frappe la plus marquée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tombol tebal dan bersudut. Terasa paling mantap saat ditekan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasti spessi e squadrati. La pressione più soddisfacente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "厚みのある角ばったキー。押し心地が最も大きいです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tykke, kantete taster. Mest tilfredsstillende å trykke på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dikke, hoekige toetsen. Het fijnste aanslaggevoel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gruba, kanciasta klawiatura. Najlepiej wyczuwalne naciśnięcie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teclas grossas e quadradas. A pressão mais satisfatória."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Толстые клавиши с острыми гранями. Самое приятное нажатие."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjocka, kantiga tangenter. Mest tillfredsställande att trycka på."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปุ่มหนาและเหลี่ยม กดแล้วรู้สึกมั่นใจที่สุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalın, köşeli tuşlar. En tatmin edici basış."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phím dày và vuông cạnh. Cảm giác nhấn rõ nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "厚实、方正的按键。按下去最有感觉。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "厚實、方正的按鍵。按下去最有感覺。"
          }
        }
      }
    },
    "두께도 그림자도 없어요. 가장 조용합니다." : {
      "comment" : "Keyboard skin description: flat",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez hloubky a bez stínu. Nejtišší varianta."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen dybde, ingen skygge. Den mest stille."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Tiefe, ohne Schatten. Die leiseste Variante."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς βάθος και σκιά. Το πιο αθόρυβο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No depth, no shadow. The quietest one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin grosor ni sombra. La más silenciosa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei syvyyttä eikä varjoa. Hiljaisin vaihtoehto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans relief ni ombre. La plus discrète."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa ketebalan, tanpa bayangan. Paling senyap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno spessore, nessuna ombra. Il più silenzioso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "厚みも影もありません。最も静かです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen dybde, ingen skygge. Den roligste."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen diepte, geen schaduw. De stilste."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez głębi i cienia. Najcichsza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem relevo e sem sombra. A mais silenciosa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без объёма и тени. Самый тихий вариант."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget djup, ingen skugga. Den tystaste."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีความหนาและไม่มีเงา เงียบที่สุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derinlik yok, gölge yok. En sessizi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không độ dày, không bóng đổ. Yên tĩnh nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有厚度也没有阴影。最安静的一种。"
