    "기기 안에서만 계산돼요. 어디에도 보내지 않아요." : {
      "comment" : "Vault: privacy note",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird nur auf diesem Gerät berechnet. Nichts wird irgendwohin gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculated on this device only. Nothing is sent anywhere."
          }
        },
