    "번역이 Apple Intelligence 없이도 동작해요. 쓸 수 있는 언어도 늘었어요" : {
      "comment" : "Changelog 5.0.8 translation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Übersetzung funktioniert jetzt auch ohne Apple Intelligence und unterstützt mehr Sprachen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Translation now works without Apple Intelligence, and covers more languages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La traducción ahora funciona sin Apple Intelligence y hay más idiomas disponibles"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翻訳がApple Intelligenceなしでも使えます。対応言語も増えました"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевод теперь работает и без Apple Intelligence. Языков стало больше."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การแปลใช้งานได้โดยไม่ต้องมี Apple Intelligence และรองรับภาษามากขึ้น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tính năng dịch giờ hoạt động không cần Apple Intelligence, và hỗ trợ thêm nhiều ngôn ngữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翻译不用 Apple Intelligence 也能用了，支持的语言也更多。"
