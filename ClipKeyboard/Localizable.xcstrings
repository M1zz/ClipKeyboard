    "두 줄까지 보여줘요. 더 많이 보이지만 키가 답답해질 수 있어요." : {
      "comment" : "Key label truncation description: two lines",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazí se až dva řádky. Vejde se víc, ale klávesy mohou působit stísněně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser op til to linjer. Du ser mere, men tasterne kan føles trange."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt bis zu zwei Zeilen. Du siehst mehr, aber die Tasten wirken enger."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφανίζονται έως δύο γραμμές. Βλέπετε περισσότερα, αλλά τα πλήκτρα μπορεί να φαίνονται στριμωγμένα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows up to two lines. You see more, but keys can feel cramped."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra hasta dos líneas. Se ve más, pero las teclas pueden sentirse apretadas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää enintään kaksi riviä. Näet enemmän, mutta näppäimet voivat tuntua ahtailta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche jusqu'à deux lignes. Vous en voyez plus, mais les touches peuvent paraître serrées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menampilkan hingga dua baris. Lebih banyak terlihat, tetapi tombol bisa terasa sempit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra fino a due righe. Si vede di più, ma i tasti possono risultare stretti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2行まで表示します。多く見えますが、キーが窮屈になることがあります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser opptil to linjer. Du ser mer, men tastene kan føles trange."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont maximaal twee regels. Je ziet meer, maar de toetsen kunnen krap aanvoelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
