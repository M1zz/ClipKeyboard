    "동작 줄이기: 설정 ON 후 즐겨찾기 추가 → 하트가 이동 없이 페이드 확인." : {
      "comment" : "Test step: Reduce Motion",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omezit pohyb: Zapněte v nastavení, přidejte do oblíbených → ověřte, že srdce jen zprůhlední a nepohybuje se."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reducer bevægelse: Slå til i indstillinger, tilføj til favoritter → kontrollér, at hjertet toner ud uden at flytte sig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegung reduzieren: In den Einstellungen aktivieren, einen Favoriten hinzufügen → prüfen, dass das Herz nur eingeblendet wird und sich nicht bewegt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μείωση κίνησης: ενεργοποιήστε την στις ρυθμίσεις, προσθέστε στα αγαπημένα και ελέγξτε ότι η καρδιά εξαφανίζεται σταδιακά χωρίς να μετακινείται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce Motion: Turn on in settings, add to favorites → confirm heart fades without moving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reducir movimiento: actívalo en ajustes, agrega a favoritos → confirma que el corazón se desvanece sin moverse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vähennä liikettä: Ota asetus käyttöön, lisää suosikkeihin → varmista, että sydän häivtyy liikkumatta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réduire les animations : activez-les dans les réglages, ajoutez aux favoris → vérifiez que le cœur s'estompe sans bouger."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurangi Gerakan: aktifkan di pengaturan, lalu tambahkan ke favorit dan pastikan ikon hati memudar tanpa bergerak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riduci movimento: attivalo nelle impostazioni, aggiungi ai preferiti → verifica che il cuore sfumi senza muoversi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動きを減らす: 設定でオンにしてお気に入りに追加 → ハートが移動せずフェードすることを確認。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduser bevegelse: Slå på i innstillinger, legg til i favoritter → bekreft at hjertet toner ut uten å flytte seg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beweging verminderen: zet dit aan in de instellingen, voeg een favoriet toe → controleer of het hart vervaagt zonder te bewegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogranicz ruch: włącz w ustawieniach, dodaj do ulubionych → sprawdź, czy serce znika bez przesuwania się."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduzir movimento: ative nos ajustes, adicione aos favoritos e confirme que o coração aparece com fade, sem se mover."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уменьшение движения: включите в настройках, добавьте в избранное → проверьте, что сердечко исчезает без движения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minska rörelse: slå på i inställningar, lägg till i favoriter → kontrollera att hjärtat tonas utan att röra sig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลดการเคลื่อนไหว: เปิดในการตั้งค่า แล้วเพิ่มรายการโปรด → ตรวจสอบว่าหัวใจค่อยๆ จางโดยไม่เคลื่อนที่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hareketi Azalt: Ayarlardan açın, favorilere ekleyin → kalbin kaymadan solduğunu doğrulayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giảm chuyển động: bật trong cài đặt, thêm vào mục ưa thích → kiểm tra trái tim mờ dần mà không di chuyển."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "减弱动态效果：在设置里打开后添加收藏 → 确认爱心只淡入淡出、不移动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "減少動態效果：在設定裡開啟後新增收藏 → 確認愛心只淡入淡出、不移動。"
          }
        }
      }
    },
