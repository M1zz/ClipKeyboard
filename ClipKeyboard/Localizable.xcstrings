          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dán nhiều dòng, hoặc tự tạo liên tiếp vài mục, là tính năng nhập hàng loạt sẽ hiện ra ngay tại đó"
