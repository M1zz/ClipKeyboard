            "value" : "ราคานี้หักส่วนที่คุณจ่ายไปสำหรับการเพิ่มช่องแล้ว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giá này đã trừ số tiền bạn đã trả cho các ô thêm."
