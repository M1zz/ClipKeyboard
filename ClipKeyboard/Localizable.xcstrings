    "다크 모드: 제어 센터에서 다크 모드 전환 → 배경·텍스트 색상 변경 확인." : {
      "comment" : "Test step: Dark Mode",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tmavý režim: přepněte tmavý režim v Ovládacím centru → ověřte změnu barvy pozadí a textu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mørk tilstand: Skift mørk tilstand i Kontrolcenter → bekræft, at baggrund og tekstfarve ændres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dunkelmodus: Im Kontrollzentrum den Dunkelmodus umschalten → Hintergrund- und Textfarbe prüfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σκούρα λειτουργία: Ενεργοποιήστε τη σκούρα λειτουργία από το Κέντρο Ελέγχου και ελέγξτε ότι αλλάζουν τα χρώματα φόντου και κειμένου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dark Mode: Toggle dark mode in Control Center → confirm background and text color changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modo oscuro: activa el modo oscuro en el Centro de control → confirma que cambian el fondo y el color del texto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tumma tila: Vaihda tumma tila Ohjauskeskuksessa → tarkista, että taustan ja tekstin värit muuttuvat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mode sombre : activez le mode sombre dans le Centre de contrôle → vérifiez que les couleurs du fond et du texte changent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mode Gelap: Aktifkan mode gelap di Pusat Kontrol → pastikan warna latar dan teks berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modalità scura: attiva la modalità scura dal Centro di Controllo → controlla che cambino i colori di sfondo e testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダークモード: コントロールセンターでダークモードを切り替え → 背景と文字の色が変わることを確認します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mørk modus: Slå på mørk modus i Kontrollsenter → bekreft at bakgrunns- og tekstfarge endres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donkere modus: schakel de donkere modus in via het Bedieningspaneel → controleer of de achtergrond- en tekstkleur veranderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryb ciemny: przełącz tryb ciemny w Centrum sterowania → sprawdź, czy zmieniły się kolory tła i tekstu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modo escuro: alterne o modo escuro na Central de Controle → confirme se as cores de fundo e de texto mudam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тёмный режим: переключите тёмный режим в Пункте управления → проверьте изменение цвета фона и текста."
          }
        },
        "sv" : {
          "stringUnit" : {
