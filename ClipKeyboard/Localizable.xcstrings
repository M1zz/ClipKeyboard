          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปลี่ยนชื่อช่องกรอกได้ ชื่อในข้อความด่วนที่ใช้ช่องนี้จะเปลี่ยนตามไปด้วย และจะแจ้งจำนวนให้ทราบก่อน"
