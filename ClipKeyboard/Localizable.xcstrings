    "계좌번호 좀 보내줄래?" : {
      "comment" : "In-app keyboard stage: sample incoming message",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kannst du mir deine Kontonummer schicken?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can you send me your account number?"
          }
        },
        "es" : {
          "stringUnit" : {
