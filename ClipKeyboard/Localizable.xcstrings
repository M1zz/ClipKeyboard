    "비워 두면 빈칸으로 남아요" : {
      "comment" : "Shortcut mart fill: field placeholder",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nechte prázdné a zůstane pole"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lad stå tomt for at beholde det som udfyldningsfelt"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leer lassen, dann bleibt es ein Ausfüllfeld"
          }
        },
        "el" : {
          "stringUnit" : {
