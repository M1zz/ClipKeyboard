        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อพิมพ์ใบเสร็จ ระบบจะใช้ช่วงเวลาที่คุณกำลังดูอยู่ และแสดงเฉพาะใบเสร็จ"
