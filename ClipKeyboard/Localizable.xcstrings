        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frasi, modelli e cronologia degli Appunti ti seguono tra iPhone e Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
