    "'탭 단축어 검색'처럼 화면에 보이는 이름을 그대로 말해 조작합니다. 모든 버튼과 입력 필드에 읽기 가능한 이름이 지정되어 있습니다." : {
      "comment" : "Voice Control feature description",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řekněte název, který vidíte na obrazovce, například 'Klepnout Hledání frází', a ovládejte aplikaci. Všechna tlačítka a pole mají čitelné názvy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sig navnet, du ser på skærmen, f.eks. 'Tryk Søg i fraser', for at styre appen. Alle knapper og felter har læsbare navne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprich den Namen, den du auf dem Bildschirm siehst, z. B. 'Tippe Snippet-Suche', um die App zu steuern. Alle Tasten und Eingabefelder haben lesbare Namen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πείτε το όνομα που βλέπετε στην οθόνη, όπως 'Πάτημα Αναζήτηση φράσεων', για να χειριστείτε την εφαρμογή. Όλα τα κουμπιά και τα πεδία εισαγωγής έχουν αναγνώσιμα ονόματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speak the name you see on screen, like 'Tap Snippet Search', to control the app. All buttons and input fields have readable names."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di el nombre que ves en pantalla, como 'Toca Buscar frase', para controlar la app. Todos los botones y campos tienen un nombre legible."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohjaa appia sanomalla näytöllä näkyvä nimi, esimerkiksi 'Napauta Fraasihaku'. Kaikilla painikkeilla ja kentillä on luettavissa oleva nimi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites le nom affiché à l'écran, comme « Toucher Recherche de phrases », pour commander l'app. Tous les boutons et champs de saisie ont un nom lisible."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ucapkan nama yang tampil di layar, seperti 'Ketuk Pencarian Frasa', untuk mengontrol aplikasi. Semua tombol dan kolom input punya nama yang bisa dibaca."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di' il nome che vedi sullo schermo, come 'Tocca Cerca frase', per usare l'app. Tutti i pulsanti e i campi hanno un nome leggibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「定型文検索をタップ」のように、画面に表示されている名前を話して操作します。すべてのボタンと入力欄に読み上げ可能な名前が付いています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si navnet du ser på skjermen, for eksempel 'Trykk Frasesøk', for å styre appen. Alle knapper og inndatafelt har lesbare navn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeg de naam die je op het scherm ziet, zoals 'Tik op Fragment zoeken', om de app te bedienen. Alle knoppen en invoervelden hebben leesbare namen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mów nazwę widoczną na ekranie, np. 'Stuknij Wyszukiwanie fraz', aby sterować aplikacją. Wszystkie przyciski i pola mają czytelne nazwy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga o nome que aparece na tela, como 'Tocar em Busca de snippet', para controlar o app. Todos os botões e campos de entrada têm nomes legíveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Произносите название, которое видите на экране, например «Нажать поиск фраз», чтобы управлять приложением. У всех кнопок и полей ввода есть понятные названия."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säg namnet du ser på skärmen, till exempel ”Tryck på Frassökning”, för att styra appen. Alla knappar och inmatningsfält har läsbara namn."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พูดชื่อที่เห็นบนหน้าจอ เช่น 'แตะ ค้นหาข้อความด่วน' เพื่อควบคุมแอป ปุ่มและช่องป้อนข้อมูลทุกช่องมีชื่อที่อ่านได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamayı kontrol etmek için 'İfade Aramasına Dokun' gibi ekranda gördüğünüz adı söyleyin. Tüm düğme ve giriş alanlarının okunabilir bir adı vardır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy nói tên hiển thị trên màn hình, như 'Nhấn Tìm kiếm cụm từ', để điều khiển ứng dụng. Mọi nút và ô nhập đều có tên có thể đọc được."
          }
        },
        "zh-Hans" : {
