        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous signalons une fois que cet onglet a deux écrans, et nous indiquons les deux façons de passer de l'un à l'autre"
          }
        },
        "id" : {
          "stringUnit" : {
