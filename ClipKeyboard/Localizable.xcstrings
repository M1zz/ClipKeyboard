        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ค่าเริ่มต้นคือสีน้ำเงินที่ iPhone ใช้ หากต้องการสีส้มแบบเดิมให้เลือกเทอราคอตตา หรือเลือกหมึกหากไม่ต้องการสี"
