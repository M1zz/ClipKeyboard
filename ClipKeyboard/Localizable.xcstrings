    "Hi team, wifi at my co-working just dropped. Back online now from a backup spot. Ready to continue whenever you are." : {
      "comment" : "Example: wifi",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobrý den, týme, wifi v mém coworkingu na chvíli vypadla. Už jsem zpět online z náhradního místa. Můžeme pokračovat, kdykoli budete chtít."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hej team, wifi på mit coworking-sted røg lige. Jeg er online igen fra en reserveplads. Klar til at fortsætte, når I er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hallo zusammen, das WLAN im Coworking-Space ist ausgefallen. Ich bin jetzt von einem anderen Ort wieder online und kann weitermachen, sobald ihr so weit seid."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γεια σας, το wifi στον χώρο coworking μόλις διακόπηκε. Είμαι ξανά online από εναλλακτικό σημείο και μπορώ να συνεχίσω όποτε θέλετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi team, wifi at my co-working just dropped. Back online now from a backup spot. Ready to continue whenever you are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hola, equipo: se cayó el wifi de mi espacio de coworking y ya volví a conectarme desde otro lugar. Listo para continuar cuando quieran."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hei tiimi, työtilan wifi katkesi hetkeksi. Olen taas verkossa varapaikasta. Voimme jatkaa, kun olette valmiita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonjour à tous, le wifi de mon espace de coworking a coupé, mais la connexion est rétablie depuis un autre endroit. Je peux reprendre quand vous voulez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
