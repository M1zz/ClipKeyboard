        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リストの後ろに写真を敷くと、ガラスのカードが映えます。右上の ⋯ メニュー > 背景画像から、いつでも変更やオフにできます。"
          }
        },
        "nb" : {
          "stringUnit" : {
