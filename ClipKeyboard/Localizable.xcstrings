    "기존 데이터가 있습니다. 복원하면 현재 데이터가 모두 삭제됩니다. 계속하시겠습니까?" : {
      "comment" : "Restore confirmation message",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Existují stávající data. Obnovením se všechna současná data smažou. Pokračovat?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der findes eksisterende data. Gendannelse sletter alle aktuelle data. Vil du fortsætte?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es sind bereits Daten vorhanden. Beim Wiederherstellen werden alle aktuellen Daten gelöscht. Fortfahren?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υπάρχουν ήδη δεδομένα. Με την επαναφορά θα διαγραφούν όλα τα τρέχοντα δεδομένα. Να συνεχίσετε;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is existing data. Restoring will delete all current data. Continue?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay datos existentes. Si restauras, se borrarán todos los datos actuales. ¿Quieres continuar?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olemassa olevia tietoja löytyi. Palautus poistaa kaikki nykyiset tiedot. Jatketaanko?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des données existent déjà. La restauration supprimera toutes les données actuelles. Continuer ?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data yang ada sudah tersimpan. Memulihkan akan menghapus semua data saat ini. Lanjutkan?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ci sono dati esistenti. Il ripristino eliminerà tutti i dati attuali. Continuare?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既存のデータがあります。復元すると現在のデータはすべて削除されます。続けますか？"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finnes eksisterende data. Gjenoppretting sletter alle gjeldende data. Vil du fortsette?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er zijn al gegevens. Bij herstellen worden alle huidige gegevens verwijderd. Doorgaan?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istnieją już dane. Przywrócenie usunie wszystkie bieżące dane. Kontynuować?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já existem dados. Ao restaurar, todos os dados atuais serão excluídos. Deseja continuar?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже есть данные. Восстановление удалит все текущие данные. Продолжить?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns redan data. Om du återställer raderas all nuvarande data. Vill du fortsätta?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีข้อมูลเดิมอยู่ การกู้คืนจะลบข้อมูลปัจจุบันทั้งหมด ต้องการดำเนินการต่อไหม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mevcut veriler var. Geri yüklerseniz tüm güncel veriler silinir. Devam edilsin mi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã có dữ liệu. Khôi phục sẽ xóa toàn bộ dữ liệu hiện tại. Bạn có muốn tiếp tục không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已经有数据了。恢复会删除当前所有数据。要继续吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已經有資料了。還原會刪除當前所有資料。要繼續嗎？"
          }
        }
      }
    },
    "기존 백업(단축어 %1$d개)을 %2$d개로 덮어쓰려고 합니다. 줄어든 데이터는 백업에서 사라집니다." : {
      "comment" : "Backup would reduce data warning",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chystáte se přepsat stávající zálohu (frází: %1$d) novou zálohou (frází: %2$d). Odebraná data se ze zálohy ztratí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er ved at overskrive den eksisterende backup (%1$d fraser) med %2$d. De fjernede data forsvinder fra backuppen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du möchtest das vorhandene Backup (%1$d Textbausteine) mit %2$d überschreiben. Die entfernten Daten gehen im Backup verloren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρόκειται να αντικαταστήσετε το υπάρχον αντίγραφο (%1$d φράσεις) με %2$d. Τα δεδομένα που λείπουν θα χαθούν από το αντίγραφο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're about to overwrite the existing backup (%1$d snippets) with %2$d. The removed data will be lost from the backup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vas a sobrescribir la copia existente (%1$d frases) con %2$d. Los datos que sobren se perderán de la copia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olemassa oleva varmuuskopio (%1$d fraasia) ollaan korvaamassa varmuuskopiolla, jossa on %2$d. Poistetut tiedot katoavat varmuuskopiosta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous allez remplacer la sauvegarde existante (%1$d phrases) par %2$d. Les données retirées disparaîtront de la sauvegarde."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda akan menimpa cadangan yang ada (%1$d Frasa) dengan %2$d. Data yang berkurang akan hilang dari cadangan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stai per sovrascrivere il backup esistente (%1$d frasi) con %2$d. I dati in meno andranno persi dal backup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既存のバックアップ(定型文%1$d件)を%2$d件で上書きしようとしています。減った分のデータはバックアップから消えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
