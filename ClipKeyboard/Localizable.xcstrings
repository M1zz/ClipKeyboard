        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto di balik daftar membuat kartu kaca terlihat hidup. Anda bisa mengubah atau mematikannya kapan saja lewat menu ⋯ > Gambar Latar."
          }
        },
        "it" : {
          "stringUnit" : {
