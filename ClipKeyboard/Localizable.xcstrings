    "카테고리에 단축어가 들어 있으면 탭을 숨기기 전에 알려드리고, 다른 카테고리로 한 번에 옮길 수 있어요" : {
      "comment" : "Changelog 4.4.7 item 2",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud kategorie obsahuje fráze, upozorníme vás před skrytím její záložky a můžete je všechny najednou přesunout do jiné kategorie."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis en kategori stadig indeholder fraser, får du besked, før fanen skjules, og du kan flytte dem alle til en anden kategori på én gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enthält eine Kategorie noch Textbausteine, sagen wir dir das, bevor der Tab ausgeblendet wird. Du kannst alle auf einmal in eine andere Kategorie verschieben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν μια κατηγορία έχει ακόμη φράσεις, θα σας ενημερώσουμε πριν κρύψετε την καρτέλα της και μπορείτε να τις μετακινήσετε όλες σε άλλη κατηγορία με μία κίνηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If a category still holds snippets, we tell you before hiding its tab, and you can move them all to another category at once."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si una categoría aún tiene frases, te avisamos antes de ocultar su pestaña y puedes pasarlas todas a otra categoría de una vez"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos luokassa on vielä fraaseja, kerromme siitä ennen välilehden piilottamista. Voit siirtää ne kaikki kerralla toiseen luokkaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si une catégorie contient encore des phrases, nous vous prévenons avant de masquer son onglet, et vous pouvez les déplacer toutes vers une autre catégorie d'un coup."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika kategori masih berisi frasa, kami beri tahu sebelum tabnya disembunyikan, dan Anda bisa memindahkan semuanya ke kategori lain sekaligus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se una categoria contiene ancora frasi, ti avvisiamo prima di nasconderne la scheda e puoi spostarle tutte in un'altra categoria in una volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カテゴリに定型文が入っているときはタブを隠す前にお知らせし、別のカテゴリへまとめて移動できます"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis en kategori fortsatt har fraser, sier vi fra før fanen skjules, og du kan flytte dem alle til en annen kategori samtidig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevat een categorie nog fragmenten, dan laten we het weten voordat je het tabblad verbergt. Je kunt ze in één keer naar een andere categorie verplaatsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli kategoria zawiera jeszcze frazy, powiemy o tym przed ukryciem jej karty. Możesz przenieść je wszystkie do innej kategorii naraz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
