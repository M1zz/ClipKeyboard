            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お支払いがなくても、作成した%d件はそのまま入力できます。Proは新規作成、バックアップ、同期のためのものです。"
          }
        },
        "ru" : {
          "variations" : {
