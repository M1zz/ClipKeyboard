    "안정성 화면에 영문 오류 대신 지금 무엇을 기다리는 상태인지 알려드려요" : {
      "comment" : "Changelog 4.4.6 item 3",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrazovka Stabilita nyní místo surové chyby ukazuje, na co čeká."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabilitetsskærmen fortæller nu, hvad den venter på, i stedet for at vise en rå fejl."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Stabilitätsansicht zeigt jetzt, worauf sie wartet, statt eines rohen Fehlers"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η οθόνη Σταθερότητα πλέον σας λέει τι περιμένει αντί να δείχνει ακατέργαστο σφάλμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Stability screen now tells you what it is waiting for instead of showing a raw error."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla de Estabilidad ahora te dice qué está esperando, en vez de mostrar un error en inglés."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vakaus-näkymä kertoo nyt, mitä se odottaa, raakavirheen sijaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'écran Stabilité vous indique désormais ce qu'il attend, au lieu d'afficher une erreur brute."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layar Stabilitas kini memberi tahu apa yang sedang ditunggu, bukan menampilkan pesan galat mentah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La schermata Stabilità ora indica cosa sta aspettando, invece di mostrare un errore grezzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安定性の画面に、英語のエラーではなく、いま何を待っているかを表示するようにしました"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabilitet-skjermen viser nå hva den venter på, i stedet for en rå feilmelding"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het scherm Stabiliteit laat nu zien waarop het wacht, in plaats van een onbegrijpelijke foutmelding."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran Stabilność podaje teraz, na co czeka, zamiast pokazywać surowy błąd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
