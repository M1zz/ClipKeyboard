        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Είναι χωρισμένες σε ομάδες όπως %1$@, με έτοιμες φράσεις όπως %2$@. Κρατήστε μόνο όσες σας αρέσουν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
