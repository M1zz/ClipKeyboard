      "shouldTranslate" : false
    },
    "메모 스크린샷이나 카드 사진의 텍스트를 인식해 위 입력창에 추가합니다. 카드 사진은 카드번호와 유효기간을 자동으로 찾아냅니다." : {
      "comment" : "Bulk import: OCR section footer",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpozná text ze snímku poznámek nebo z fotky karty a přidá ho do pole výše. U fotek karet se automaticky najde číslo karty a platnost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genkender tekst fra et skærmbillede af noter eller et kortfoto og føjer den til feltet ovenfor. På kortfotos findes kortnummer og udløbsdato automatisk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkennt Text aus Notiz-Screenshots oder Kartenfotos und fügt ihn oben in das Eingabefeld ein. Bei Kartenfotos werden Kartennummer und Ablaufdatum automatisch gefunden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναγνωρίζει κείμενο από στιγμιότυπο σημειώσεων ή φωτογραφία κάρτας και το προσθέτει στο πεδίο παραπάνω. Στις κάρτες εντοπίζονται αυτόματα ο αριθμός και η λήξη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recognizes text from a notes screenshot or card photo and adds it to the input above. For card photos, the card number and expiry date are detected automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconoce el texto de una captura de notas o de una foto de tarjeta y lo agrega al campo de arriba. En fotos de tarjeta, detecta el número y la fecha de vencimiento automáticamente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunnistaa tekstin muistiinpanojen kuvakaappauksesta tai korttikuvasta ja lisää sen yllä olevaan kenttään. Korttikuvasta löytyvät automaattisesti kortin numero ja voimassaoloaika."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconnaît le texte d'une capture d'écran de notes ou d'une photo de carte et l'ajoute à la zone de saisie ci-dessus. Pour une photo de carte, le numéro et la date d'expiration sont détectés automatiquement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengenali teks dari tangkapan layar catatan atau foto kartu, lalu menambahkannya ke kolom input di atas. Pada foto kartu, nomor kartu dan masa berlaku dikenali otomatis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riconosce il testo di uno screenshot di note o di una foto di carta e lo aggiunge al campo sopra. Per le foto di carte, numero e scadenza vengono rilevati in automatico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモのスクリーンショットやカード写真の文字を認識して、上の入力欄に追加します。カード写真は、カード番号と有効期限を自動で見つけます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjenkjenner tekst fra et skjermbilde av notater eller et kortbilde og legger den til i feltet over. På kortbilder finnes kortnummer og utløpsdato automatisk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herkent tekst uit een screenshot van notities of een kaartfoto en voegt die toe aan het invoerveld hierboven. Bij kaartfoto's worden het kaartnummer en de vervaldatum automatisch gevonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpoznaje tekst ze zrzutu ekranu notatek lub zdjęcia karty i dodaje go do pola powyżej. Na zdjęciu karty numer i data ważności są wykrywane automatycznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconhece o texto de uma captura de tela de notas ou de uma foto de cartão e adiciona ao campo acima. Em fotos de cartão, o número e a validade são detectados automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Распознаёт текст со скриншота заметок или фото карты и добавляет его в поле выше. На фото карты номер и срок действия определяются автоматически."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Känner igen text i en skärmbild av anteckningar eller ett kortfoto och lägger till den i fältet ovan. På kortfoton hittas kortnummer och giltighetstid automatiskt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระบบจะอ่านข้อความจากภาพหน้าจอโน้ตหรือรูปบัตร แล้วเพิ่มลงในช่องกรอกด้านบน สำหรับรูปบัตร ระบบจะหาเลขบัตรและวันหมดอายุให้อัตโนมัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not ekran görüntüsündeki veya kart fotoğrafındaki metni tanıyıp yukarıdaki alana ekler. Kart fotoğraflarında kart numarası ve son kullanma tarihi otomatik bulunur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhận dạng văn bản từ ảnh chụp màn hình ghi chú hoặc ảnh thẻ rồi thêm vào ô nhập ở trên. Với ảnh thẻ, số thẻ và ngày hết hạn sẽ được tự động tìm ra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "识别备忘录截图或卡片照片里的文字，并添加到上面的输入框。卡片照片会自动找出卡号和有效期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "識別備忘錄截圖或卡片照片裡的文字，並新增到上面的輸入框。卡片照片會自動找出卡號和有效期。"
          }
        }
      }
    },
