    "선택한 사용 패턴에 맞는 카테고리예요. 탭하면 만들어서 단축어를 한곳에 모을 수 있어요." : {
      "comment" : "Persona category suggestion tip message",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyto kategorie odpovídají tomu, jak aplikaci používáte. Klepnutím ji vytvoříte a své fráze budete mít na jednom místě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kategorier, der passer til dit valg. Tryk for at oprette en og samle dine fraser ét sted."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Kategorien passen zu deiner Nutzung. Tippe auf eine, um sie anzulegen und deine Textbausteine an einem Ort zu sammeln."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κατηγορίες που ταιριάζουν με τη χρήση σας. Πατήστε μία για να τη δημιουργήσετε και να συγκεντρώσετε τις φράσεις σας σε ένα σημείο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These match how you use the app. Tap one to create it and gather your snippets in one place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas categorías se ajustan a cómo usas la app. Toca una para crearla y reunir tus frases en un solo lugar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nämä sopivat tapaasi käyttää appia. Luo luokka napauttamalla, niin fraasit pysyvät yhdessä paikassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces catégories correspondent à votre usage. Touchez-en une pour la créer et regrouper vos phrases au même endroit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kategori ini sesuai dengan cara Anda memakai app. Ketuk untuk membuatnya dan kumpulkan frasa Anda di satu tempat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Categorie adatte al tuo modo di usare l'app. Toccane una per crearla e riunire le frasi in un unico posto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んだ使い方に合うカテゴリです。タップして作成すると、定型文を一か所にまとめられます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kategorier som passer til hvordan du bruker appen. Trykk på en for å opprette den og samle fraser på ett sted."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze categorieën passen bij hoe je de app gebruikt. Tik op een categorie om hem te maken en je fragmenten op één plek te bewaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kategorie pasujące do tego, jak używasz aplikacji. Stuknij, aby ją utworzyć i zebrać frazy w jednym miejscu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "São categorias que combinam com o seu uso. Toque em uma para criá-la e reunir suas frases em um só lugar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти категории соответствуют тому, как вы пользуетесь приложением. Нажмите, чтобы создать и собрать фразы в одном месте."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kategorier som passar hur du använder appen. Tryck på en för att skapa den och samla dina fraser på ett ställe."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หมวดหมู่นี้ตรงกับวิธีที่คุณใช้แอป แตะเพื่อสร้างและรวมข้อความด่วนไว้ในที่เดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunlar kullanım biçiminize uyan kategoriler. Dokunarak oluşturun, İfadelerinizi tek yerde toplayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các danh mục này phù hợp với cách bạn dùng ứng dụng. Chạm để tạo và gom các cụm từ vào một nơi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些和你的使用方式相符。点一下就能创建，把短语集中到一处。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些和你的使用方式相符。點一下就能建立，把短語集中到一處。"
          }
        }
      }
    },
    "선택한 시점의 데이터로 복원됩니다. 현재 데이터는 교체됩니다." : {
      "comment" : "Version restore footer",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnoví data ze zvoleného okamžiku. Aktuální data budou nahrazena."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gendanner data fra det valgte tidspunkt. Dine nuværende data erstattes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellt die Daten vom gewählten Zeitpunkt wieder her. Deine aktuellen Daten werden ersetzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα γίνει επαναφορά των δεδομένων από το επιλεγμένο σημείο. Τα τρέχοντα δεδομένα θα αντικατασταθούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restores the data from the selected point in time. Your current data will be replaced."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se restaurarán los datos del momento seleccionado. Los datos actuales se reemplazarán."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palauttaa valitun ajankohdan tiedot. Nykyiset tiedot korvataan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaure les données du moment sélectionné. Les données actuelles seront remplacées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data dipulihkan dari titik waktu yang dipilih. Data Anda saat ini akan diganti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripristina i dati del momento selezionato. I dati attuali verranno sostituiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んだ時点のデータに復元します。現在のデータは置き換えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 시점의 데이터로 복원됩니다. 현재 데이터는 교체됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjenoppretter dataene fra det valgte tidspunktet. Dine nåværende data blir erstattet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herstelt de gegevens van het gekozen moment. Je huidige gegevens worden vervangen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przywraca dane z wybranego momentu. Obecne dane zostaną zastąpione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaura os dados do ponto selecionado. Os dados atuais serão substituídos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные будут восстановлены на выбранный момент времени. Текущие данные будут заменены."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data från den valda tidpunkten återställs. Dina nuvarande data ersätts."
