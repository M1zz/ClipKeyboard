          }
        }
      }
    },
    "번역하지 못했어요. 잠시 후 다시 시도해 주세요." : {
      "comment" : "Translation failed error",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't translate. Please try again soon."
