    "설정 > 키보드에서 '전체 접근 허용'을 켜주세요" : {
      "comment" : "Full Access required toast",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte v Nastavení > Klávesnice volbu „Povolit plný přístup“"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå 'Tillad fuld adgang' til under Indstillinger › Tastatur"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere in Einstellungen > Tastatur „Vollzugriff erlauben“"
