        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je fragmenten, sjablonen en klembordgeschiedenis volgen je tussen iPhone en Mac."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frazy, szablony i historia schowka podążają za Tobą między iPhone a Mac."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas frases, modelos e histórico da área de transferência acompanham você entre o iPhone e o Mac."
