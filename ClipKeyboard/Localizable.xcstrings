    "자동 붙여넣기가 차단됩니다. 하지만 길게 눌러서 수동으로 붙여넣기는 가능합니다." : {
      "comment" : "Deny option description",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatické vkládání bude zablokováno. Dlouhým stisknutím ale můžete vkládat ručně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisk indsættelse blokeres. Du kan stadig indsætte manuelt med et langt tryk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisches Einfügen wird blockiert. Du kannst aber weiterhin manuell durch langes Drücken einfügen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αυτόματη επικόλληση θα αποκλειστεί. Μπορείτε όμως να επικολλήσετε χειροκίνητα με παρατεταμένο πάτημα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto paste will be blocked. However, you can still paste manually with a long press."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se bloqueará el pegado automático. Aun así, puedes pegar manualmente con una pulsación larga."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaattinen liittäminen estetään. Voit silti liittää käsin painamalla pitkään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le collage automatique sera bloqué. Vous pourrez toujours coller manuellement par un appui long."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempel otomatis akan diblokir. Namun, Anda tetap bisa menempel secara manual dengan menekan lama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'incolla automatico verrà bloccato. Puoi comunque incollare manualmente con una pressione prolungata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動ペーストはブロックされます。ただし、長押しで手動ペーストはできます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisk liming blir blokkert. Du kan likevel lime inn manuelt med et langt trykk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch plakken wordt geblokkeerd. Je kunt wel handmatig plakken door lang te drukken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatyczne wklejanie zostanie zablokowane. Nadal można wkleić ręcznie, przytrzymując palec."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
