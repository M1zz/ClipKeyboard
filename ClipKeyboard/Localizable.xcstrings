    "요청이 너무 많습니다. 잠시 후 다시 시도해주세요." : {
      "comment" : "Rate limited error message",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Příliš mnoho požadavků. Zkuste to prosím později."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For mange anmodninger. Prøv igen om lidt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu viele Anfragen. Versuche es später noch einmal."
