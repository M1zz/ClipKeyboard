    "Dusk·Paper 두 테마 모두 다크 모드를 완전히 지원합니다. 시스템 설정을 따르거나 앱 내에서 직접 선택할 수 있습니다." : {
      "comment" : "Dark Mode feature description",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vzhledy Dusk a Paper plně podporují tmavý režim. Můžete sledovat nastavení systému nebo zvolit přímo v aplikaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Både Dusk og Paper understøtter mørk tilstand fuldt ud. Følg systemets indstillinger, eller vælg direkte i appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Themen Dusk und Paper unterstützen den Dunkelmodus vollständig. Du kannst den Systemmodus übernehmen oder direkt in der App wählen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Και τα δύο θέματα, Dusk και Paper, υποστηρίζουν πλήρως τη σκοτεινή λειτουργία. Ακολουθήστε τις ρυθμίσεις συστήματος ή επιλέξτε απευθείας στην εφαρμογή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both Dusk and Paper themes fully support dark mode. Follow system settings or choose directly within the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los temas Dusk y Paper son totalmente compatibles con el modo oscuro. Puedes seguir los ajustes del sistema o elegirlo directamente en la app."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekä Dusk- että Paper-teema tukevat täysin tummaa tilaa. Seuraa järjestelmän asetuksia tai valitse tila suoraan sovelluksessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les thèmes Dusk et Paper prennent tous deux en charge le mode sombre. Suivez les réglages du système ou choisissez directement dans l'app."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tema Dusk dan Paper sama-sama mendukung mode gelap sepenuhnya. Ikuti pengaturan sistem atau pilih langsung di aplikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I temi Dusk e Paper supportano del tutto la modalità scura. Segui le impostazioni di sistema o scegli direttamente nell'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DuskとPaperの両テーマとも、ダークモードに完全対応しています。システム設定に合わせることも、アプリ内で選ぶこともできます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Både Dusk og Paper støtter mørk modus fullt ut. Følg systeminnstillingene eller velg direkte i appen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zowel Dusk als Paper ondersteunt de donkere modus volledig. Volg de systeeminstellingen of kies zelf in de app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oba tematy, Dusk i Paper, w pełni obsługują tryb ciemny. Możesz zostawić ustawienia systemu albo wybrać tryb w aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os temas Dusk e Paper são totalmente compatíveis com o modo escuro. Siga os ajustes do sistema ou escolha direto no app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обе темы, Dusk и Paper, полностью поддерживают тёмный режим. Используйте системные настройки или выберите тему прямо в приложении."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Både Dusk och Paper stöder mörkt läge fullt ut. Följ systeminställningarna eller välj direkt i appen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ธีม Dusk และ Paper รองรับโหมดมืดอย่างสมบูรณ์ ใช้ตามการตั้งค่าระบบหรือเลือกเองในแอปได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dusk ve Paper temalarının ikisi de koyu modu tam destekler. Sistem ayarını izleyebilir veya uygulama içinden seçebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cả hai chủ đề Dusk và Paper đều hỗ trợ đầy đủ chế độ tối. Bạn có thể theo cài đặt hệ thống hoặc chọn ngay trong ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dusk 和 Paper 两种主题都完整支持深色模式。可以跟随系统设置，也可以在 App 内直接选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dusk 和 Paper 兩種主題都完整支援深色模式。可以跟隨系統設定，也可以在 App 內直接選擇。"
          }
        }
      }
    },
