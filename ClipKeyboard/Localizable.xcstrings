    "카드번호 입력: 1234 → 5678 → 9012 → 3456" : {
      "comment" : "Combo example",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter card number: 1234 → 5678 → 9012 → 3456"
          }
        },
