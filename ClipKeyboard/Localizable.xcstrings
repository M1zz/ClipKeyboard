    "정규식으로 알아보기 어렵던 것을 기기 안의 AI가 다시 분류해요" : {
      "comment" : "Changelog 4.3.6 item 1",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI auf dem Gerät ordnet neu zu, was sich per Muster nicht erkennen ließ"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On-device AI reclassifies what pattern matching could not identify"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La IA del dispositivo reclasifica lo que los patrones no lograban identificar"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パターン照合で判別しにくかった項目を、端末内のAIが分類し直します"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ИИ на устройстве заново классифицирует то, что не смог распознать шаблон"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI ในเครื่องจัดประเภทใหม่ให้กับสิ่งที่การจับรูปแบบข้อความระบุไม่ได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI trên thiết bị phân loại lại những mục mà quy tắc mẫu không nhận ra được"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正则难以判断的内容，交给设备上的 AI 重新分类"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正則難以判斷的內容，交給裝置上的 AI 重新分類"
          }
        }
      }
    },
    "정규식으로 확신하기 어려운 클립보드 항목(주소, 이름, 송장번호 등)을 온디바이스 AI가 다시 분류해요." : {
      "comment" : "AI classification footer",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI auf dem Gerät ordnet Einträge der Zwischenablage neu zu, die sich per Muster nicht sicher erkennen lassen (Adressen, Namen, Sendungsnummern u. a.)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On-device AI re-classifies clipboard items that pattern matching can't identify confidently (addresses, names, tracking numbers, and more)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La IA del dispositivo vuelve a clasificar los elementos del portapapeles que los patrones no identifican con certeza (direcciones, nombres, números de rastreo, etc.)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パターン照合では判別しにくいクリップボードの項目(住所、名前、追跡番号など)を、端末内のAIが分類し直します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ИИ на устройстве заново классифицирует элементы буфера обмена, которые сложно точно определить по шаблону (адреса, имена, номера отслеживания и другое)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI ในเครื่องจะจัดประเภทรายการในคลิปบอร์ดใหม่ หากการจับรูปแบบข้อความระบุได้ไม่มั่นใจ (ที่อยู่ ชื่อ เลขพัสดุ และอื่นๆ)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI trên thiết bị phân loại lại các mục bảng tạm mà quy tắc mẫu khó xác định chắc chắn (địa chỉ, tên, mã vận đơn, v.v.)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正则无法确信判断的剪贴板项目（地址、姓名、运单号等），会由设备上的 AI 重新分类。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正則無法確信判斷的剪貼簿項目（地址、姓名、運單號等），會由裝置上的 AI 重新分類。"
          }
        }
      }
    },
