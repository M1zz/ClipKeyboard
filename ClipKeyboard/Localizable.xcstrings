      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stejná událost se zaznamená nejvýše jednou za 6 hodin na jednu instalaci. Sledujte poměry mezi kroky, ne absolutní počty."
