    "앞 4자리(국가코드+검증번호)를 다시 확인해 주세요. 나머지는 형식이 맞습니다." : {
      "comment" : "Repair hint when IBAN checksum fails",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe die ersten 4 Zeichen (Ländercode + Prüfziffern). Der Rest passt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the first 4 characters (country code + check digits). The rest looks right."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa los primeros 4 caracteres (código de país y dígitos de control). El resto tiene el formato correcto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初の4文字(国コードとチェックデジット)をもう一度確認してください。残りの形式は合っています。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте первые 4 символа (код страны и контрольные цифры). Остальное указано верно."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โปรดตรวจสอบ 4 ตัวแรก (รหัสประเทศ + เลขตรวจสอบ) อีกครั้ง ส่วนที่เหลือรูปแบบถูกต้อง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy kiểm tra lại 4 ký tự đầu (mã quốc gia + số kiểm tra). Phần còn lại đúng định dạng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请再确认一下前 4 位（国家代码 + 校验位）。其余部分格式是对的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請再確認一下前 4 位（國家代碼 + 檢查碼）。其餘部分格式是對的。"
          }
        }
      }
    },
    "앞뒤를 남기고 가운데만 줄여요. 앞이 비슷한 이름끼리도 구분돼요." : {
      "comment" : "Key label truncation description: middle",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behält Anfang und Ende und kürzt die Mitte. So bleiben Namen mit ähnlichem Anfang unterscheidbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps the start and the end, shortening the middle, so names that start alike stay tellable apart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva el inicio y el final, y acorta la parte del medio. Así se distinguen los nombres que empiezan igual."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前後を残して、真ん中だけ省略します。前半が似た名前でも見分けられます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начало и конец остаются, сокращается середина, поэтому похожие вначале названия легко отличить."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เก็บส่วนหัวและส่วนท้ายไว้ ย่อเฉพาะตรงกลาง ชื่อที่ขึ้นต้นคล้ายกันจึงยังแยกออก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ phần đầu và phần cuối, rút gọn ở giữa. Các tên có phần đầu giống nhau vẫn phân biệt được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留开头和结尾，只缩短中间，所以开头相似的名字也能分得清。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留開頭和結尾，只縮短中間，所以開頭相似的名字也能分得清。"
          }
        }
      }
    },
