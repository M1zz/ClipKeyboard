    "Copy a VAT number in format PT123456789 or EU123456789, the app recognizes it as \"VAT / Tax ID\" and masks on display." : {
      "comment" : "Smart clipboard hint: VAT recognition",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopierst du eine VAT-Nummer im Format PT123456789 oder EU123456789, erkennt die App sie als \"VAT / Steuernummer\" und blendet sie in der Anzeige aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy a VAT number in format PT123456789 or EU123456789, the app recognizes it as \"VAT / Tax ID\" and masks on display."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si copias un número de VAT con formato PT123456789 o EU123456789, la app lo reconoce como \"VAT / ID fiscal\" y lo oculta en pantalla."
          }
        },
        "ja" : {
