        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palautteen mukana voit nyt antaa nimen ja sähköpostin vastausta varten. Täytä ne kerran, niin täytämme ne puolestasi jatkossa"
