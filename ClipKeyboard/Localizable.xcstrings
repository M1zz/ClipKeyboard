        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัวอย่างคีย์บอร์ดเลื่อนขึ้นลงได้นุ่มนวลในครั้งเดียว และเคอร์เซอร์ในช่องป้อนข้อความกะพริบแล้ว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
