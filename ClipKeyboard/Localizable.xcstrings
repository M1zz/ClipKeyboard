    "기본 키보드보다 윗줄 하나만큼 높아요. 단축어가 더 보입니다." : {
      "comment" : "Keyboard height preset description: standard",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O řádek vyšší než standardní klávesnice, vejde se víc frází."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Én række højere end standardtastaturet, så flere fraser er synlige."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Zeile höher als die Standardtastatur. Es passen mehr Textbausteine hin."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μία γραμμή ψηλότερο από το τυπικό πληκτρολόγιο, ώστε να χωράνε περισσότερες φράσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One row taller than the standard keyboard, so more snippets fit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una fila más alta que el teclado estándar, así caben más frases."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhden rivin verran tavallista näppäimistöä korkeampi, joten fraaseja mahtuu enemmän."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une rangée de plus que le clavier standard. Davantage de phrases visibles."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu baris lebih tinggi dari keyboard standar, jadi lebih banyak Frasa terlihat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alta una riga in più della tastiera standard, così vedi più frasi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標準のキーボードより1段高く、定型文がより多く見えます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En rad høyere enn standardtastaturet. Du ser flere fraser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een rij hoger dan het standaardtoetsenbord, zodat er meer fragmenten passen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O jeden rząd wyższa niż standardowa klawiatura, więc mieści się więcej fraz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma linha mais alto que o teclado padrão, para caberem mais frases."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На одну строку выше стандартной клавиатуры, поэтому видно больше фраз."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En rad högre än standardtangentbordet, så fler fraser får plats."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สูงกว่าคีย์บอร์ดมาตรฐานหนึ่งแถว จึงแสดงข้อความด่วนได้มากขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standart klavyeden bir satır daha yüksektir, daha fazla ifade sığar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cao hơn bàn phím tiêu chuẩn một hàng, nên hiện được nhiều cụm từ hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比系统键盘高出一行，能看到更多短语。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比系統鍵盤高出一行，能看到更多短語。"
          }
        }
      }
    },
    "기본 키보드와 높이가 같아요. 키보드를 바꿔도 화면이 움직이지 않습니다. 단축어는 굴려서 봅니다." : {
      "comment" : "Keyboard height preset description: compact",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stejná výška jako standardní klávesnice, takže se při přepnutí klávesnice obraz nehýbe. Fráze procházejte posouváním."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samme højde som standardtastaturet, så intet flytter sig, når du skifter tastatur. Rul for at se flere fraser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So hoch wie die Standardtastatur, beim Wechseln springt also nichts. Textbausteine scrollst du durch."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ίδιο ύψος με το τυπικό πληκτρολόγιο, οπότε η οθόνη δεν μετακινείται όταν αλλάζετε πληκτρολόγιο. Κάντε κύλιση για περισσότερες φράσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The same height as the standard keyboard, so nothing shifts when you switch keyboards. Scroll to see more snippets."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misma altura que el teclado estándar, así nada se mueve al cambiar de teclado. Desliza para ver más frases."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhtä korkea kuin tavallinen näppäimistö, joten näkymä ei liiku näppäimistöä vaihtaessasi. Selaa nähdäksesi lisää fraaseja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même hauteur que le clavier standard : l'écran ne bouge pas quand vous changez de clavier. Faites défiler pour voir les phrases."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tingginya sama dengan keyboard standar, jadi layar tidak bergeser saat Anda berganti keyboard. Gulir untuk melihat Frasa lainnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alta come la tastiera standard, quindi nulla si sposta quando cambi tastiera. Scorri per vedere altre frasi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標準のキーボードと同じ高さです。キーボードを切り替えても画面が動きません。定型文はスクロールで見ます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samme høyde som standardtastaturet, så skjermen flytter seg ikke når du bytter tastatur. Rull for å se fraser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even hoog als het standaardtoetsenbord, dus er verschuift niets als je van toetsenbord wisselt. Scroll om meer fragmenten te zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ma taką samą wysokość jak standardowa klawiatura, więc nic się nie przesuwa po zmianie klawiatury. Przewiń, aby zobaczyć więcej fraz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesma altura do teclado padrão, então nada se mexe ao trocar de teclado. Role para ver mais frases."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Такая же высота, как у стандартной клавиатуры: при переключении ничего не смещается. Фразы можно прокручивать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samma höjd som standardtangentbordet, så inget flyttar sig när du byter tangentbord. Rulla för att se fler fraser."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สูงเท่าคีย์บอร์ดมาตรฐาน เมื่อสลับคีย์บอร์ดหน้าจอจึงไม่ขยับ เลื่อนดูข้อความด่วนเพิ่มเติมได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standart klavyeyle aynı yüksekliktedir, klavye değiştirince ekran kaymaz. İfadeleri kaydırarak görürsünüz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cao bằng bàn phím tiêu chuẩn, nên màn hình không bị xê dịch khi bạn đổi bàn phím. Cuộn để xem thêm cụm từ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与系统键盘同高，切换键盘时画面不会跳动。短语可以滚动查看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與系統鍵盤同高，切換鍵盤時畫面不會跳動。短語可以滾動查看。"
          }
        }
      }
    },
