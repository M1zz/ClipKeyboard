        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พิมพ์เฉพาะชื่อ ไม่ต้องใส่วงเล็บปีกกา หากเขียน {ชื่อ} ในข้อความด่วน ระบบจะดึงช่องกรอกนี้มาใช้"
