            "value" : "Anonyme Diagnosedaten von MetricKit. Enthalten sind nur Call Stack, App-Version und OS: keine Nutzerdaten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonymous diagnostics from MetricKit. Only the call stack, app version, and OS are included: no user information."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagnósticos anónimos de MetricKit. Solo incluyen la traza de llamadas, la versión de la app y el sistema operativo. No se incluye información del usuario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
