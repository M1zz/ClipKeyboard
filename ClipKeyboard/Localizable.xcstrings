    "단축어 하나에 템플릿을 붙여 쓸 수 있어요" : {
      "comment" : "Changelog 4.0.8 item 1",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K jedné frázi lze připojit šablonu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan knytte en skabelon til en frase"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Textbaustein kann eine Vorlage enthalten"
          }
        },
        "el" : {
          "stringUnit" : {
