        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez indiquer un nom et un e-mail pour recevoir une réponse. Une fois saisis, nous les remplirons pour vous la prochaine fois"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
