    "음성 명령: '탭 단축어 검색' 또는 '확인 탭' 말하기 → 반응 확인." : {
      "comment" : "Test step: Voice Control",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovládání hlasem: Řekněte 'Klepnout Hledání frází' nebo 'Klepnout OK' → ověřte odezvu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stemmestyring: Sig 'Tryk på Søg i fraser' eller 'Tryk på OK' → tjek svaret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprachsteuerung: Sage 'Tippe auf Textbaustein-Suche' oder 'Tippe auf OK' → Reaktion prüfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φωνητικός έλεγχος: Πείτε «Πάτημα Αναζήτηση φράσεων» ή «Πάτημα OK» → ελέγξτε την ανταπόκριση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voice Control: Say 'Tap Snippet Search' or 'Tap OK' → confirm response."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Control por voz: di «Tocar Buscar frase» o «Tocar OK» → confirma que responde."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puheohjaus: sano \"Napauta Fraasihaku\" tai \"Napauta OK\" ja tarkista vastaus."
