        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνεχίζετε να γράφετε εδώ, γι' αυτό ο δρομέας ξεκινά τώρα εδώ. Μπορείτε να το απενεργοποιήσετε στην επεξεργασία της φράσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You keep typing here, so the cursor now starts here. Turn it off in the snippet editor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigues escribiendo aquí, así que puse el cursor aquí. Puedes desactivarlo en la edición de la frase."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jatkat kirjoittamista tästä, joten kohdistin alkaa nyt tästä. Voit poistaa tämän käytöstä fraasin muokkauksessa."
