    "아직 저장된 변경 기록이 없어요. 단축어를 추가·편집·삭제하면 직전 상태가 자동으로 여기에 보관돼요 (최근 10개)." : {
      "comment" : "Empty memo history",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatím nemáte žádnou historii změn. Když přidáte, upravíte nebo smažete fráze, předchozí stav se sem automaticky uloží (posledních 10)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen ændringshistorik endnu. Når du tilføjer, redigerer eller sletter fraser, gemmes den forrige tilstand automatisk her (de seneste 10)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch kein Änderungsverlauf. Wenn du Textbausteine hinzufügst, bearbeitest oder löschst, wird der vorherige Stand hier automatisch gesichert (letzte 10)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχει ιστορικό αλλαγών ακόμη. Όταν προσθέτετε, επεξεργάζεστε ή διαγράφετε φράσεις, η προηγούμενη κατάσταση αποθηκεύεται εδώ αυτόματα (τελευταίες 10)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No change history yet. When you add, edit, or delete snippets, the previous state is saved here automatically (last 10)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay historial de cambios. Al agregar, editar o eliminar frases, el estado anterior se guarda aquí automáticamente (últimos 10)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei vielä muutoshistoriaa. Kun lisäät, muokkaat tai poistat fraaseja, edellinen tila tallentuu tänne automaattisesti (viimeiset 10)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun historique pour l'instant. Quand vous ajoutez, modifiez ou supprimez des phrases, l'état précédent est conservé ici automatiquement (10 derniers)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada riwayat perubahan. Saat Anda menambah, mengubah, atau menghapus frasa, kondisi sebelumnya otomatis disimpan di sini (10 terakhir)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora nessuna cronologia delle modifiche. Quando aggiungi, modifichi o elimini frasi, lo stato precedente viene salvato qui in automatico (ultime 10)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更履歴はまだありません。定型文を追加・編集・削除すると、直前の状態が自動でここに保存されます(最新10件)。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen endringslogg ennå. Når du legger til, redigerer eller sletter fraser, lagres forrige tilstand automatisk her (siste 10)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog geen wijzigingsgeschiedenis. Als je fragmenten toevoegt, wijzigt of verwijdert, wordt de vorige staat hier automatisch bewaard (laatste 10)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak historii zmian. Gdy dodasz, edytujesz lub usuniesz frazy, poprzedni stan zapisze się tu automatycznie (ostatnie 10)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não há histórico de alterações. Ao adicionar, editar ou excluir frases, o estado anterior é salvo aqui automaticamente (últimos 10)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История изменений пока пуста. При добавлении, редактировании или удалении фраз предыдущее состояние сохраняется здесь автоматически (последние 10)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen ändringshistorik än. När du lägger till, ändrar eller tar bort fraser sparas det tidigare läget här automatiskt (senaste 10)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่มีประวัติการเปลี่ยนแปลง เมื่อเพิ่ม แก้ไข หรือลบข้อความด่วน สถานะก่อนหน้าจะถูกเก็บไว้ที่นี่อัตโนมัติ (10 รายการล่าสุด)"
