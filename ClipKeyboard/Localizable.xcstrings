    "자리를 잡았어요. 한도에 닿으면 결제로 이어지는 무리예요." : {
      "comment" : "Segment hint: regular",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie sind angekommen. Diese Gruppe wechselt zum Kauf, wenn das Limit erreicht ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They've settled in. This is the group that converts when they hit the limit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya se acomodaron. Son quienes pasan al pago al llegar al límite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定着してきた層です。上限に達すると課金につながるグループです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Они освоились. Эта группа платит, когда достигает лимита."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เริ่มใช้งานประจำแล้ว กลุ่มนี้มักอัปเกรดเมื่อถึงขีดจำกัด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Họ đã quen dùng. Đây là nhóm sẽ nâng cấp khi chạm giới hạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他们已经安顿下来了。这群人碰到上限就会付费。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他們已經安頓下來了。這群人碰到上限就會付費。"
          }
        }
      }
    },
    "자물쇠가 켜진 항목은 보안 단축어로 암호화되어 저장됩니다." : {
      "comment" : "Bulk import: secure footer",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objekte mit aktiviertem Schloss werden verschlüsselt als sichere Textbausteine gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items with the lock turned on are encrypted and saved as secure snippets."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos con el candado activado se guardan cifrados como frases seguras."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロックがオンの項目は、セキュア定型文として暗号化して保存されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Элементы с включённым замком сохраняются как зашифрованные защищённые фразы."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รายการที่เปิดล็อกไว้จะถูกเข้ารหัสและบันทึกเป็นข้อความด่วนที่ปลอดภัย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mục bật khóa sẽ được mã hóa và lưu thành cụm từ bảo mật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开锁的项目会加密保存为加密短语。"
          }
        },
