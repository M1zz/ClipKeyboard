        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα στοιχεία με ενεργό κλείδωμα αποθηκεύονται κρυπτογραφημένα ως ασφαλείς φράσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items with the lock turned on are encrypted and saved as secure snippets."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos con el candado activado se guardan cifrados como frases seguras."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lukitut kohteet salataan ja tallennetaan suojattuina fraaseina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éléments dont le cadenas est activé sont chiffrés et enregistrés comme phrases sécurisées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
