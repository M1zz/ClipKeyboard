    "키 개수·높이·글자 크기·색을 취향대로 바꿀 수 있어요. 한 화면에 여덟 개를 띄우는 사람도 있습니다." : {
      "comment" : "DYK body: keyboard look",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počet kláves, výšku, velikost písma i barvy nastavíte podle sebe. Někteří lidé mají na obrazovce osm kláves."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antal taster, højde, tekststørrelse og farver: alt kan du selv vælge. Nogle får otte taster på én skærm."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tastenanzahl, Höhe, Schriftgröße und Farben stellst du frei ein. Manche zeigen acht Tasten auf einem Bildschirm."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αριθμός, ύψος, μέγεθος γραμμάτων και χρώμα των πλήκτρων: τα ορίζετε εσείς. Κάποιοι χωρούν οκτώ πλήκτρα σε μία οθόνη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Key count, height, text size, colors: all yours to set. Some people fit eight keys on one screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cantidad, altura, tamaño de letra y color de las teclas: todo a tu gusto. Hay quien pone ocho teclas en una pantalla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näppäinten määrän, korkeuden, tekstikoon ja värit voit valita itse. Jotkut mahtuttavat yhdelle näytölle kahdeksan näppäintä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre, hauteur, taille du texte, couleurs : tout se règle à votre goût. Certains affichent huit touches sur un seul écran."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jumlah, tinggi, ukuran teks, dan warna tombol bisa Anda atur sendiri. Ada yang memuat delapan tombol dalam satu layar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numero, altezza, dimensione del testo e colore dei tasti: decidi tu. C'è chi ne mette otto in una schermata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーの数、高さ、文字サイズ、色を好みに合わせて変えられます。1画面に8個並べる人もいます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antall taster, høyde, tekststørrelse og farger kan du velge selv. Noen får plass til åtte taster på én skjerm."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aantal toetsen, hoogte, tekstgrootte en kleuren stel je zelf in. Sommigen zetten acht toetsen op één scherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczbę klawiszy, wysokość, rozmiar tekstu i kolory ustawisz po swojemu. Niektórzy mieszczą na ekranie osiem klawiszy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quantidade, altura, tamanho do texto e cor das teclas: tudo ao seu gosto. Tem quem coloque oito teclas na mesma tela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Количество клавиш, высоту, размер текста и цвет можно настроить как удобно. У некоторых на одном экране помещается восемь клавиш."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antal tangenter, höjd, textstorlek och färger kan du ställa in som du vill. Vissa får plats med åtta tangenter på en skärm."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปรับจำนวนปุ่ม ความสูง ขนาดตัวอักษร และสีได้ตามต้องการ บางคนใช้แปดปุ่มในหน้าจอเดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuş sayısı, yükseklik, yazı boyutu, renkler: hepsi size kalmış. Bazı kişiler tek ekrana sekiz tuş sığdırıyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể tùy chỉnh số phím, chiều cao, cỡ chữ và màu. Có người để tám phím trên một màn hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按键数量、高度、字号、颜色都可以按喜好调。也有人在一屏里放八个键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按鍵數量、高度、字體大小、顏色都可以按喜好調。也有人在一屏裡放八個鍵。"
          }
        }
      }
    },
