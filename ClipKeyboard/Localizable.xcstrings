          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiana działa w aplikacji od razu. Klawiatura zmieni się przy następnym otwarciu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica no app na hora. O teclado muda na próxima vez que você abri-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяется в приложении сразу. В клавиатуре изменится при следующем открытии."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gäller direkt i appen. Tangentbordet ändras nästa gång du öppnar det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้กับแอปทันที ส่วนคีย์บอร์ดจะเปลี่ยนเมื่อเปิดครั้งถัดไป"
          }
