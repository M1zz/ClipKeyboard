        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta frase tem um modelo vinculado. Preencha os campos e o resultado é copiado junto com a frase. Veja o resultado combinado em 'Prévia' abaixo."
