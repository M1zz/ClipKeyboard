          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep it on to send right after inserting a snippet. Turn it off if you want more room."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjalo activado si quieres enviar justo después de insertar una frase. Si no lo necesitas, apágalo para tener más espacio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä päällä, jos haluat lähettää heti fraasin lisäämisen jälkeen. Sammuta, jos haluat enemmän tilaa."
