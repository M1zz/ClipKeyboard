    "• 복구 시 현재 데이터는 백업 데이터로 교체됩니다" : {
      "comment" : "Backup info 2",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Při obnovení se aktuální data nahradí zálohou"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Ved gendannelse erstattes dine nuværende data af backupdata"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Beim Wiederherstellen werden die aktuellen Daten durch die Backup-Daten ersetzt"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Κατά την επαναφορά, τα τρέχοντα δεδομένα αντικαθίστανται από τα δεδομένα του αντιγράφου"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Current data will be replaced with backup data during restore"
          }
        },
        "es" : {
