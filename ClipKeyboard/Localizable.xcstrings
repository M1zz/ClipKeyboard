        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα πεδία συμπλήρωσης ομαδοποιούνται ανά όνομα. Αν χρησιμοποιήσετε το ίδιο όνομα σε πολλές φράσεις, μοιράζονται τις τιμές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blanks are grouped by name. Use the same name in several snippets and they share its values."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los campos se agrupan por nombre. Si varias frases usan el mismo nombre, comparten sus valores."
