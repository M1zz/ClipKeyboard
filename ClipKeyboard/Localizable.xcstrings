            "value" : "Rettet: Synkronisering mellem enheder tabte alle ændringer og sletninger efter den første upload."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behoben: Beim Geräteabgleich gingen alle Änderungen und Löschungen nach dem ersten Hochladen verloren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διορθώθηκε ο συγχρονισμός συσκευών που αγνοούσε κάθε επεξεργασία και διαγραφή μετά την πρώτη μεταφόρτωση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixed sync between devices dropping every edit and deletion after the first upload."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corregimos que la sincronización entre dispositivos ignoraba las ediciones y eliminaciones posteriores a la primera subida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korjasimme virheen, jossa synkronointi laitteiden välillä ohitti kaikki muokkaukset ja poistot ensimmäisen lähetyksen jälkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
