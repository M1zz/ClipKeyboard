    "18 moments where ClipKeyboard saves you minutes, or rescues a mistake." : {
      "comment" : "Usage guide hero subtitle",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
