        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι νέοι χρήστες δεν χρειάζεται πια να δημιουργήσουν κάτι. Τους δίνουμε έτοιμες φράσεις για να δοκιμάσουν"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
