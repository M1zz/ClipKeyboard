        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Исчезнут %1$d полей и %2$d сохранённых в них значений. Ни одна фраза их не использует."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ช่องกรอก %1$d ช่องและค่าที่บันทึกไว้ %2$d ค่าจะหายไป ไม่มีข้อความด่วนใดใช้อยู่เลย"
