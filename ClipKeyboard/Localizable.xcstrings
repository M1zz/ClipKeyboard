    "위로 이동" : {
      "comment" : "Move combo value up",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move up"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上移"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
