    "짧아서 아끼는 시간은 작지만, 자주 쓰면 쌓여요." : {
      "comment" : "Saving kind explanation: quick",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokaždé ušetří málo, ale při častém používání se to sčítá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver gang sparer det lidt, men det bliver til meget, når du bruger det ofte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro Einsatz spart es wenig, aber es summiert sich."
