    "복사한 것을 넣는 키를 위줄에 세웁니다. 길게 누르면 필요한 부분만 고를 수 있어요" : {
      "comment" : "Clipboard key description",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klávesa vložení je v horní řadě. Podržením vyberete jen potřebnou část."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placerer indsæt-tasten i øverste række. Hold nede for at vælge kun den del, du skal bruge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt die Einsetzen-Taste in die obere Reihe. Gedrückt halten, um nur den nötigen Teil zu wählen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάζει το πλήκτρο επικόλλησης στην επάνω σειρά. Πατήστε παρατεταμένα για να διαλέξετε μόνο το κομμάτι που θέλετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puts the paste key in the top row. Press and hold to pick just the part you need."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pone la tecla de pegar en la fila superior. Mantén presionado para elegir solo la parte que necesitas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuo liitä-näppäimen ylimmälle riville. Pidä painettuna ja valitse vain tarvitsemasi osa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place la touche de collage sur la rangée du haut. Maintenez-la pour choisir seulement la partie voulue."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menaruh tombol tempel di baris atas. Tekan lama untuk memilih bagian yang diperlukan saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mette il tasto Incolla nella riga in alto. Tieni premuto per scegliere solo la parte che ti serve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貼り付けキーを最上段に置きます。長押しすると、必要な部分だけ選べます。"
          }
