        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一つの用途にぴったり使っています。二つ目の使い道を伝えると広がります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De bruker den til én ting. Vis dem en ny bruk, så vokser den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gebruikt het voor precies één taak. Laat een tweede toepassing zien en het gebruik groeit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używają go tylko do jednej rzeczy. Pokaż drugie zastosowanie, a urośnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usam para uma tarefa só. Mostre um segundo uso e eles usam mais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используют только для одной задачи. Покажите вторую, и активность вырастет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De använder den till en enda sak. Visa en andra användning, så växer den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้กับงานเดียวพอดี ลองบอกวิธีใช้แบบที่สองแล้วจะใช้มากขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek bir iş için kullanıyorlar. İkinci bir kullanım gösterirseniz artar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Họ đang dùng cho đúng một việc. Gợi ý cho họ cách dùng thứ hai thì mức dùng sẽ tăng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他们只把它用在一件事上。告诉他们第二种用法，用量就会涨。"
