        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erätuonti näyttää esikatselun näppäimistönä ennen tallennusta. Napauta näppäintä jättääksesi sen pois"
          }
        },
        "fr" : {
          "stringUnit" : {
