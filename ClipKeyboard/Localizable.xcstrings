            "value" : "Your snippets weren't deleted: we just couldn't read the file. The original has been kept safe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se borraron tus frases: no pudimos leer el archivo. El original está guardado."
