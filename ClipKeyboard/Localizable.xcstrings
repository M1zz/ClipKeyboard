          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette app n'a pas de serveur. Vos numéros de compte et d'identité restent sur ce téléphone, et nous ne pouvons pas les voir. Sans serveur à pirater, rien ne peut être piraté."
          }
        },
        "id" : {
          "stringUnit" : {
