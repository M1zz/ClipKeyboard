          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una settimana dopo, ancora niente creato. Compare la schermata con gli esempi da scegliere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
