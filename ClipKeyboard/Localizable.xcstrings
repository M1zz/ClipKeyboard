        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yönlendirme ilk ifadenizi oluşturmaya kadar sürer. İsim, değerin nereden geldiği, yapıştırılacak içerik ve Kaydet adımlarını yukarıdan sırayla gösterir"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phần hướng dẫn theo bạn đến lúc tạo cụm từ đầu tiên, đi qua từng mục từ trên xuống: tên, nguồn của giá trị, nội dung sẽ dán và Lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
