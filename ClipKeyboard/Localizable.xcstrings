        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εφαρμόζεται αμέσως στην εφαρμογή. Το πληκτρολόγιο αλλάζει την επόμενη φορά που θα το ανοίξετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to the app right away. The keyboard changes the next time you open it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica en la app al elegirlo. El teclado cambia la próxima vez que lo abras."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otetaan käyttöön heti sovelluksessa. Näppäimistö vaihtuu, kun avaat sen seuraavan kerran."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appliqué à l'app tout de suite. Le clavier changera à sa prochaine ouverture."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langsung berlaku di aplikasi. Keyboard berubah saat Anda membukanya lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
