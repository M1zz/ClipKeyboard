          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ก่อนถึงตอนนั้นจะตั้งเป็นทั่วไป ค่าเริ่มต้นเดิมคือดิจิทัลโนแมดเป็นจุดเริ่มต้นของแอป ไม่ใช่ตัวตนของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O zamana kadar Genel olarak kalır. Eski varsayılan Dijital Göçebe, uygulamanın başladığı yerdi, sizin olduğunuz yer değil"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho đến lúc đó, ứng dụng để ở chế độ Chung. Mặc định cũ là Digital Nomad, đó là nơi ứng dụng bắt đầu, không phải nơi bạn đang đứng"
          }
