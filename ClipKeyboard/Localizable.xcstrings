    "번역이 Apple Intelligence 없이도 동작해요. 쓸 수 있는 언어도 늘었어요" : {
      "comment" : "Changelog 5.0.8 translation",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Překlad nově funguje i bez Apple Intelligence a podporuje více jazyků."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oversættelse virker nu uden Apple Intelligence og dækker flere sprog."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Übersetzung funktioniert jetzt auch ohne Apple Intelligence und unterstützt mehr Sprachen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η μετάφραση λειτουργεί πλέον και χωρίς Apple Intelligence, με περισσότερες γλώσσες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Translation now works without Apple Intelligence, and covers more languages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La traducción ahora funciona sin Apple Intelligence y hay más idiomas disponibles"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käännös toimii nyt ilman Apple Intelligencea ja tukee useampia kieliä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La traduction fonctionne désormais sans Apple Intelligence, et couvre plus de langues"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terjemahan kini berfungsi tanpa Apple Intelligence, dan mencakup lebih banyak bahasa"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La traduzione ora funziona anche senza Apple Intelligence e copre più lingue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翻訳がApple Intelligenceなしでも使えます。対応言語も増えました"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oversettelse fungerer nå uten Apple Intelligence, og dekker flere språk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertalen werkt nu ook zonder Apple Intelligence en ondersteunt meer talen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tłumaczenie działa teraz bez Apple Intelligence i obsługuje więcej języków."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tradução agora funciona sem o Apple Intelligence e cobre mais idiomas"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевод теперь работает и без Apple Intelligence. Языков стало больше."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Översättning fungerar nu utan Apple Intelligence och omfattar fler språk."
          }
        },
