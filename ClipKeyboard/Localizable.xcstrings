    "남에게 보여주기 싫은 건 잠글 수 있어요" : {
      "comment" : "DYK title: secure memo",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ty, které nechcete ukazovat, můžete zamknout"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan låse dem, du helst ikke vil vise"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was niemand sehen soll, kannst du sperren"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπορείτε να κλειδώσετε όσα δεν θέλετε να δείχνετε"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can lock the ones you'd rather not show"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes bloquear lo que no quieras mostrar"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit lukita ne, joita et halua näyttää muille"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez verrouiller ce que vous préférez ne pas montrer"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang tidak ingin Anda perlihatkan bisa dikunci"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi bloccare quelle che preferisci non mostrare"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "見せたくないものはロックできます"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan låse det du helst ikke vil vise frem"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat je liever niet laat zien, kun je vergrendelen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te, których nie chcesz pokazywać, możesz zablokować"
