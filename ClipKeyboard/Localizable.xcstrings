    "Long-press to drag and reorder. Swipe left to delete (protected ones can't be removed)." : {
      "comment" : "Categories footer hint",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržením přetáhnete a změníte pořadí, přejetím doleva smažete (chráněné položky smazat nelze)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk og hold for at trække og ændre rækkefølge. Stryg til venstre for at slette (beskyttede kan ikke fjernes)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lange drücken und ziehen zum Sortieren, nach links wischen zum Löschen (geschützte Einträge lassen sich nicht löschen)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε παρατεταμένα και σύρετε για αλλαγή σειράς. Σύρετε αριστερά για διαγραφή (τα προστατευμένα δεν διαγράφονται)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long-press to drag and reorder. Swipe left to delete (protected ones can't be removed)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén presionado para arrastrar y reordenar. Desliza a la izquierda para eliminar (los protegidos no se pueden eliminar)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Järjestä painamalla pitkään ja vetämällä. Poista pyyhkäisemällä vasemmalle (suojattuja ei voi poistaa)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez longuement pour réorganiser par glisser. Balayez vers la gauche pour supprimer (les éléments protégés ne peuvent pas l'être)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekan lama untuk menyeret dan mengurutkan ulang. Geser ke kiri untuk menghapus (item yang dilindungi tidak bisa dihapus)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto per trascinare e riordinare. Scorri a sinistra per eliminare (gli elementi protetti non si possono rimuovere)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長押しでドラッグして並べ替え、左にスワイプで削除できます(保護された項目は削除不可)。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "길게 누르면 드래그로 순서 변경, 왼쪽으로 밀면 삭제 (보호된 항목은 삭제 불가)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk og hold for å dra og endre rekkefølge. Sveip til venstre for å slette (beskyttede kan ikke fjernes)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd ingedrukt om te slepen en de volgorde te wijzigen. Veeg naar links om te verwijderen (beveiligde items kunnen niet worden verwijderd)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj i przeciągnij, aby zmienić kolejność. Przesuń w lewo, aby usunąć (chronionych elementów nie można usunąć)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha pressionado para arrastar e reordenar. Deslize para a esquerda para excluir (itens protegidos não podem ser excluídos)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте, чтобы перетащить и изменить порядок. Смахните влево, чтобы удалить (защищённые элементы удалить нельзя)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll nedtryckt och dra för att ändra ordning. Svep åt vänster för att ta bort (skyddade går inte att ta bort)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กดค้างเพื่อลากจัดลำดับ ปัดซ้ายเพื่อลบ (ลบรายการที่ป้องกันไว้ไม่ได้)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sürükleyerek sıralamak için basılı tutun. Silmek için sola kaydırın (korumalı öğeler silinemez)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn giữ rồi kéo để đổi thứ tự, vuốt sang trái để xóa (mục được bảo vệ không thể xóa)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按可拖动排序。左滑删除（受保护的无法删除）。"
