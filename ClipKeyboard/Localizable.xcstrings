    "사용 기록으로 남아요" : {
      "comment" : "Living skin trait: persistent",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleibt im Nutzungsverlauf"
          }
        },
        "en" : {
