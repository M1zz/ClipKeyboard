            "state" : "translated",
            "value" : "Tách ngăn xếp"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拆开短语堆"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
