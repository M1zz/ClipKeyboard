          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe Dinge wie Matrikelnummer oder Aufgaben-Mails mit einem Tipp über die Tastatur. %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type things like your student ID or assignment emails in one tap from the keyboard. %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe en un toque, desde el teclado, lo que siempre tecleas, como tu matrícula o correos de tareas. %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "学籍番号や課題のメールなど、毎回打つ文章をキーボードからワンタップで入力できます。%@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "학번이나 과제 메일처럼 매번 치는 글을 키보드에서 한 번에 넣어요. %@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Такие вещи, как студенческий номер или email для заданий, вводите одним тапом с клавиатуры. %@"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พิมพ์ข้อความที่ใช้ซ้ำๆ เช่น รหัสนักศึกษาหรืออีเมลส่งงาน จากคีย์บอร์ดในแตะเดียว %@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập những thứ bạn gõ mỗi ngày như mã số sinh viên hay email nộp bài chỉ với một chạm trên bàn phím. %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "学号、作业邮件这类每次都要打的内容，在键盘上一键输入。%@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "學號、作業郵件這類每次都要打的內容，在鍵盤上一鍵輸入。%@"
          }
        }
      }
    },
