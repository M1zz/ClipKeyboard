        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn \"Lưu thành Phím tắt\" trong danh sách bên dưới bảng chia sẻ, mục sẽ được lưu ngay mà không cần mở màn hình"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在共享表单的操作列表里点“存为短语”，不用打开界面就能一次存好"
          }
