      "comment" : "Delight effects toggle footer",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The tap you feel and the brief mark you see when a snippet goes in. Turn it off to insert silently."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
