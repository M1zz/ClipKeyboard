    "Your memos, templates and clipboard history follow you between iPhone and Mac." : {
      "comment" : "Mac feature: sync description",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše fráze, šablony a historie schránky vás provázejí mezi iPhonem a Macem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine fraser, skabeloner og udklipsholderhistorik følger dig mellem iPhone og Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Textbausteine, Vorlagen und der Verlauf der Zwischenablage folgen dir zwischen iPhone und Mac."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
