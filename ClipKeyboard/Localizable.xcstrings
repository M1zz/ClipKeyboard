    "시작하는 김에, 반값으로 열어 둘래요?" : {
      "comment" : "Discount offer title: first run",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když už začínáte, odemknete za poloviční cenu?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du nu er i gang, vil du låse op til halv pris?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du schon dabei bist: Soll es zum halben Preis freigeschaltet werden?"
