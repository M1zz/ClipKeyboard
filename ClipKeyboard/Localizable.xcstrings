          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Counted on your device only. Nothing is sent anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cuenta solo en tu dispositivo. No se envía a ningún lado."
          }
        },
