          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus frases, plantillas e historial del portapapeles te siguen entre iPhone y Mac."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fraasit, pohjat ja leikepöytähistoria seuraavat sinua iPhonen ja Macin välillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
