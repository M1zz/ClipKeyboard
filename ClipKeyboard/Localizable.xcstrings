    "손가락으로 문질러 고릅니다. 문지르기 어려우면 오른쪽 위 줄로 고르기를 쓰세요." : {
      "comment" : "Smear picker canvas (a11y hint)",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vybírejte přejížděním prstem. Pokud je to obtížné, použijte Vybrat podle řádku vpravo nahoře."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stryg med fingeren for at vælge. Hvis det er svært, kan du bruge Vælg via linje øverst til højre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wische mit dem Finger, um auszuwählen. Falls das schwerfällt, nutze oben rechts „Nach Zeile wählen“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύρετε το δάχτυλό σας για να επιλέξετε. Αν δυσκολεύεστε, χρησιμοποιήστε την Επιλογή ανά γραμμή πάνω δεξιά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe with your finger to pick. If swiping is hard, use Pick by line at the top right."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza el dedo para elegir. Si te cuesta deslizar, usa Elegir por línea, arriba a la derecha."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse pyyhkäisemällä sormella. Jos pyyhkäiseminen on vaikeaa, käytä oikean yläkulman valintaa riveittäin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser le doigt pour choisir. Si c'est difficile, utilisez Choisir par ligne en haut à droite."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geser dengan jari untuk memilih. Jika sulit menggeser, gunakan Pilih per baris di kanan atas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa il dito per scegliere. Se è difficile, usa Scegli per riga in alto a destra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指でなぞって選びます。なぞりにくいときは、右上の線で選ぶを使ってください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra fingeren over for å velge. Er det vanskelig, bruk Velg etter linje øverst til høyre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg met je vinger om te kiezen. Lukt vegen niet, gebruik dan rechtsboven Kies op regel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń palcem, aby wybrać. Jeśli to trudne, użyj opcji Wybór z listy w prawym górnym rogu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize o dedo para escolher. Se for difícil deslizar, use Escolher por linha, no canto superior direito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбирайте, проводя пальцем. Если так неудобно, используйте «Выбор по строке» в правом верхнем углу."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svep med fingret för att välja. Om det är svårt att svepa, använd Välj med linje uppe till höger."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้นิ้วลากเพื่อเลือก หากลากยาก ให้ใช้เลือกทีละบรรทัดที่มุมขวาบน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçmek için parmağınızla sürükleyin. Sürüklemek zorsa sağ üstteki Satırla seç'i kullanın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuốt bằng ngón tay để chọn. Nếu khó vuốt, hãy dùng Chọn theo dòng ở góc trên bên phải."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用手指划着选。划不动的话，用右上角的“按行选择”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用手指滑著選。滑不動的話，用右上角的「按行選擇」。"
          }
        }
      }
    },
