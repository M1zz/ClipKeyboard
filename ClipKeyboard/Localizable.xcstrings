          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El naranja de antes. Elígelo si prefieres dejar todo como estaba."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aiemmin käytössä ollut oranssi. Valitse tämä, niin kaikki pysyy ennallaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
