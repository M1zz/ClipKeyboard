            "state" : "translated",
            "value" : "先生、{学科}の{学籍番号}、{名前}です。\n{科目}の{課題}を提出いたします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안녕하세요 교수님, {학과} {학번} {이름}입니다.\n{과목} {과제} 제출드립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hei professor, dette er {studieretning} {studentnummer} {navn}.\nJeg leverer {oppgave} i {emne}."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geachte professor, met {naam} ({studierichting}, {studentnummer}).\nHierbij stuur ik mijn {opdracht} voor {vak}."
          }
        },
        "pl" : {
