          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng đã nhanh hơn. Không còn đứng hình khi mở, và việc xử lý trong 10 giây đầu giảm một nửa"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
