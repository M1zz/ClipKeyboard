        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока что установлен профиль «Общий». Прежний вариант по умолчанию, «Цифровой кочевник», был точкой старта приложения, а не тем, где сейчас вы"
          }
