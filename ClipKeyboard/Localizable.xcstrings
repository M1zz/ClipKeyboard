            "state" : "translated",
            "value" : "Selamat siang Prof, saya {nama} ({jurusan}, {NIM}).\nSaya kirimkan {tugas} untuk {mata kuliah}."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buongiorno professore, sono {nome} ({facoltà}, {matricola}).\nLe invio {compito} di {corso}."
          }
