          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En anonym ögonblicksbild per installation, så antalet installationer motsvarar antalet enheter som använder appen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การติดตั้งแต่ละครั้งมีสแนปช็อตแบบไม่ระบุตัวตน 1 รายการ จำนวนการติดตั้งจึงเท่ากับจำนวนอุปกรณ์ที่ใช้แอปนี้"
