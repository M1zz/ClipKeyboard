        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hola {contacto}, gracias por la reunión de hoy con {cliente}.\nTemas: {resumen}\nSiguiente paso: {siguiente paso} ({próxima fecha})"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hei {yhteyshenkilö}, kiitos tämänpäiväisestä tapaamisesta ({asiakas}).\nKäsitelty: {yhteenveto}\nSeuraava askel: {seuraava askel} ({seuraava ajankohta})"
