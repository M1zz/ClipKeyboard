    "기기 안에서만 계산돼요. 어디에도 보내지 않아요." : {
      "comment" : "Vault: privacy note",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počítá se jen v tomto zařízení. Nic se nikam neodesílá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beregnes kun på denne enhed. Intet sendes nogen steder hen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird nur auf diesem Gerät berechnet. Nichts wird irgendwohin gesendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο υπολογισμός γίνεται μόνο σε αυτή τη συσκευή. Δεν στέλνεται πουθενά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculated on this device only. Nothing is sent anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se calcula solo en este dispositivo. No se envía a ningún lado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasketaan vain tällä laitteella. Mitään ei lähetetä minnekään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calcul effectué uniquement sur l'appareil. Rien n'est envoyé ailleurs."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dihitung hanya di perangkat ini. Tidak dikirim ke mana pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calcolato solo su questo dispositivo. Non viene inviato da nessuna parte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末の中だけで計算します。どこにも送信しません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beregnes bare på enheten. Ingenting sendes noe sted."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt alleen op dit apparaat berekend. Er wordt niets verzonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obliczenia odbywają się tylko na tym urządzeniu. Nic nie jest nigdzie wysyłane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cálculo é feito só neste dispositivo. Nada é enviado para lugar nenhum."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вычисляется только на этом устройстве. Никуда не отправляется."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beräknas bara på enheten. Inget skickas någonstans."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำนวณบนอุปกรณ์เครื่องนี้เท่านั้น ไม่ส่งไปที่ใด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca bu cihazda hesaplanır. Hiçbir yere gönderilmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ tính toán trên thiết bị này. Không gửi đi đâu cả."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只在这台设备上计算。不会发送到任何地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只在這台裝置上計算。不會發送到任何地方。"
          }
        }
      }
    },
