        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klavyeyi Ayarlar'dan kaldırsanız bile hatırlatmanın bir daha çıkmaması düzeltildi. Artık Ayarlar listesi her seferinde kontrol ediliyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã sửa lỗi: nếu bạn gỡ bàn phím trong Cài đặt, lời nhắc bật sẽ không hiện lại. Giờ ứng dụng kiểm tra danh sách Cài đặt mỗi lần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
