        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al agregar una frase, primero aparece un espacio vacío y el editor se abre encima. Así ves dónde quedará."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
