          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilan dasar yang polos. Kartu merespons dengan empuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aspetto piatto e semplice. Le card rispondono con un morbido rimbalzo."
          }
        },
