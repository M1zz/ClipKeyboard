        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθηκεύονται ως πρόχειρες μόνο φράσεις με πραγματικές αλλαγές, χωρίς συσσώρευση πρόχειρων"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drafts only save when you actually made changes, no more draft pile-up"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los borradores solo se guardan si hiciste cambios, y ya no se acumulan"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
