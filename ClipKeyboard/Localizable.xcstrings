    "단축어 안에 {커서} 를 적어 두면, 넣은 뒤 커서가 그 자리에 섭니다. 뒷말을 이어 쓸 때 손이 덜 갑니다." : {
      "comment" : "DYK body: cursor token",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když do fráze vložíte {kurzor}, kurzor se po vložení zastaví na tomto místě. Při psaní dalšího textu to ušetří pár klepnutí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv {markør} i en frase, så stopper markøren der, når frasen er indsat. Så kan du skrive videre uden besvær."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibst du {Cursor} in einen Textbaustein, bleibt der Cursor nach dem Einfügen genau dort stehen. So musst du beim Weiterschreiben weniger tippen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γράψτε {δρομέας} μέσα σε μια φράση και ο δρομέας θα σταματά εκεί μετά την εισαγωγή. Συνεχίζετε να γράφετε πιο εύκολα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put {cursor} in a snippet and the cursor stops there after it's typed. Less reaching when you keep writing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe {cursor} en una frase y el cursor quedará ahí después de insertarla. Así te cuesta menos seguir escribiendo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoita fraasiin {kohdistin}, niin kohdistin jää siihen paikkaan, kun fraasi on lisätty. Jatkaminen on helpompaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placez {curseur} dans une phrase : une fois insérée, le curseur s'arrête à cet endroit. Pratique pour continuer à écrire."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulis {kursor} di dalam frasa, maka kursor berhenti di situ setelah frasa dimasukkan. Lebih mudah saat Anda lanjut menulis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi {cursore} in una frase e, dopo l'inserimento, il cursore si ferma lì. Così continui a scrivere senza spostarti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定型文の中に {カーソル} を書いておくと、入力後にカーソルがその位置に来ます。続きを書くときに手間が減ります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv {markør} i en frase, så stopper markøren der etter at den er satt inn. Da slipper du å flytte den når du skriver videre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet {cursor} in een fragment, dan blijft de cursor daar staan na het invoegen. Zo kun je makkelijker verder typen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz {kursor} we frazie, a po jej wstawieniu kursor stanie w tym miejscu. Łatwiej pisać dalej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreva {cursor} em uma frase e, depois de inserida, o cursor fica nesse ponto. Dá menos trabalho para continuar escrevendo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Впишите {курсор} внутри фразы, и после вставки курсор окажется на этом месте. Меньше лишних движений при продолжении набора."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv {markör} i en fras, så stannar markören där efter att frasen har lagts in. Då slipper du flytta den när du skriver vidare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใส่ {เคอร์เซอร์} ไว้ในข้อความด่วน เมื่อพิมพ์แล้วเคอร์เซอร์จะอยู่ตรงนั้น พิมพ์ต่อได้สะดวกขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir ifadenin içine {imleç} yazarsanız, ifade girildikten sonra imleç o yerde durur. Yazmaya devam ederken işiniz kolaylaşır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn ghi {con trỏ} trong cụm từ, con trỏ sẽ dừng ở đó sau khi nhập. Đỡ phải với tay khi bạn viết tiếp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在短语里写上 {光标}，填入之后光标就会停在那个位置。接着往下写时手上省事。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在短語裡寫上 {光標}，填入之後光標就會停在那個位置。接著往下寫時手上省事。"
          }
        }
      }
    },
