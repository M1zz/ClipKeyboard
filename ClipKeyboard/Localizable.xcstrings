            "value" : "Split into one snippet per line so you can pull each one up separately on the keyboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guarda una frase por línea para que las uses por separado en el teclado."
          }
        },
        "fi" : {
          "stringUnit" : {
