    "템플릿·스택·단축어+템플릿 예시 4개를 추가해 직접 써볼 수 있어요. 기존 단축어는 그대로 유지돼요." : {
      "comment" : "Demo samples offer message",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte 4 ukázky (šablonu, zásobník a frázi se šablonou) a vyzkoušejte je. Vaše stávající fráze zůstanou beze změny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj 4 eksempler (skabelon, stak og frase + skabelon), så du kan prøve dem. Dine eksisterende fraser bliver, som de er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge 4 Beispiele hinzu (Vorlage, Stapel und Textbaustein + Vorlage), um sie auszuprobieren. Deine vorhandenen Textbausteine bleiben unverändert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε 4 παραδείγματα (πρότυπο, στοίβα και φράση + πρότυπο) για να τα δοκιμάσετε. Οι υπάρχουσες φράσεις παραμένουν ως έχουν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add 4 examples (template, stack, and snippet + template) to try them out. Your existing snippets stay untouched."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega 4 ejemplos (plantilla, pila y frase + plantilla) para probarlos. Tus frases actuales no se tocan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää 4 esimerkkiä (pohja, pino ja fraasi + pohja), niin voit kokeilla niitä. Nykyiset fraasit säilyvät ennallaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez 4 exemples (modèle, pile, et phrase + modèle) pour les essayer. Vos phrases existantes restent inchangées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan 4 contoh (templat, tumpukan, dan frasa + templat) untuk dicoba. Frasa Anda yang sudah ada tetap aman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi 4 esempi (modello, pila e frase + modello) per provarli. Le tue frasi restano invariate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テンプレート、スタック、定型文+テンプレートの例を4つ追加して試せます。既存の定型文はそのままです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til 4 eksempler (mal, stabel og frase + mal) så du kan prøve dem. Eksisterende fraser beholdes som de er."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg 4 voorbeelden toe (sjabloon, stapel en fragment + sjabloon) om ze uit te proberen. Je bestaande fragmenten blijven zoals ze zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj 4 przykłady (szablon, stos oraz fraza + szablon), żeby je wypróbować. Twoje frazy zostaną bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione 4 exemplos (modelo, pilha e frase + modelo) para experimentar. Suas frases atuais continuam como estão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте 4 примера (шаблон, стопка и фраза с шаблоном), чтобы попробовать самим. Ваши текущие фразы останутся без изменений."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till 4 exempel (mall, stapel och fras + mall) så kan du prova själv. Dina befintliga fraser behålls."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มตัวอย่าง 4 รายการ (เทมเพลต สแตก และข้อความด่วน + เทมเพลต) ให้ลองใช้ ข้อความด่วนเดิมจะไม่เปลี่ยนแปลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şablon, yığın ve ifade + şablon olmak üzere 4 örnek ekleyip deneyebilirsiniz. Mevcut ifadeleriniz olduğu gibi kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm 4 ví dụ (mẫu, ngăn xếp, cụm từ + mẫu) để bạn dùng thử. Các cụm từ hiện có vẫn được giữ nguyên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加 4 个示例（模板、短语堆，以及短语+模板），可以直接上手试。已有的短语不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增 4 個示例（範本、短語堆，以及短語+範本），可以直接上手試。已有的短語不受影響。"
          }
        }
      }
    },
    "템플릿·콤보·단축어+템플릿 예시 4개를 추가해 직접 써볼 수 있어요. 기존 단축어는 그대로 유지돼요." : {
      "comment" : "Demo samples offer message",
      "extractionState" : "stale",
