          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι μαζικές εισαγωγές εμφανίζονται πλέον ως πληκτρολόγιο πριν την αποθήκευση. Πατήστε ένα πλήκτρο για να το εξαιρέσετε"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batch imports now preview as your keyboard before saving, tap a key to leave it out"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al importar en lote, ahora ves una vista previa como teclado antes de guardar. Toca una tecla para dejarla fuera"
