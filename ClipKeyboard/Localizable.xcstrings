      "shouldTranslate" : false
    },
    "키보드에서 단축어를 길게 누르면 입력 대신 클립보드로 들어가요. 붙여넣을 곳이 따로 있을 때 쓰세요." : {
      "comment" : "DYK body: long press",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržíte-li frázi na klávesnici, vloží se do schránky místo napsání. Hodí se, když vkládáte jinam."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold en frase nede på tastaturet, så havner den i udklipsholderen i stedet for at blive skrevet. Praktisk, når du skal indsætte et andet sted."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte einen Textbaustein auf der Tastatur gedrückt, dann landet er in der Zwischenablage statt im Text. Praktisch, wenn du woanders einfügen willst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε παρατεταμένα μια φράση στο πληκτρολόγιο και αντιγράφεται στο πρόχειρο αντί να πληκτρολογηθεί. Χρήσιμο όταν επικολλάτε αλλού."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold a snippet on the keyboard and it goes to the clipboard instead of being typed. Handy when you're pasting somewhere else."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén presionada una frase en el teclado y va al portapapeles en vez de escribirse. Útil cuando vas a pegar en otro lado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun pidät fraasia pohjassa näppäimistössä, se menee leikepöydälle eikä kirjoitu. Hyödyllinen, kun liität muualle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez longuement sur une phrase du clavier : elle va dans le presse-papiers au lieu d'être saisie. Utile pour coller ailleurs."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekan lama frasa di keyboard, maka frasa masuk ke Papan Klip, bukan diketik. Berguna saat Anda menempel di tempat lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuta una frase sulla tastiera: va negli appunti invece di essere scritta. Utile se devi incollarla altrove."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボードで定型文を長押しすると、入力せずにクリップボードへ入ります。別の場所に貼り付けたいときにお使いください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold inne en frase på tastaturet, så havner den på utklippstavlen i stedet for å bli skrevet inn. Praktisk når du skal lime inn et annet sted."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd een fragment op het toetsenbord ingedrukt en het gaat naar het klembord in plaats van te worden getypt. Handig als je ergens anders plakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj frazę na klawiaturze, a trafi do schowka zamiast zostać wpisana. Przydaje się, gdy wklejasz gdzie indziej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure uma frase no teclado e ela vai para a área de transferência em vez de ser digitada. Útil para colar em outro lugar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удержите фразу на клавиатуре, и она попадёт в буфер обмена вместо ввода. Удобно, если нужно вставить в другом месте."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll in en fras på tangentbordet så hamnar den i urklipp i stället för att skrivas in. Bra när du ska klistra in någon annanstans."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กดข้อความด่วนค้างบนคีย์บอร์ด ข้อความจะไปอยู่ในคลิปบอร์ดแทนการพิมพ์ ใช้เมื่อต้องการวางที่อื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klavyede bir ifadeye uzun bastığınızda yazılmak yerine panoya kopyalanır. Başka bir yere yapıştıracaksanız işe yarar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn giữ một cụm từ trên bàn phím để đưa vào bảng tạm thay vì nhập. Tiện khi bạn cần dán ở nơi khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在键盘上长按短语，它不会被输入，而是进剪贴板。要粘到别处时很方便。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
