        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$d z %1$d kategorii nie ma żadnej frazy. Uporządkuj te nieużywane, a przewijanie listy będzie dużo lżejsze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$d das suas %1$d categorias não têm nenhuma frase. Organizar as que você não usa deixa a lista bem mais leve ao deslizar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В %2$d из %1$d категорий нет ни одной фразы. Уберите лишние, и пролистывать список станет намного легче."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$d av dina %1$d kategorier har inga fraser alls. Städar du bort dem du inte använder går det lättare att svepa i listan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จากหมวดหมู่ %1$d รายการ มี %2$d รายการที่ไม่มีข้อความด่วนเลย ลองจัดระเบียบรายการที่ไม่ได้ใช้ การเลื่อนดูรายการจะเบาขึ้นมาก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$d kategorinin %2$d tanesinde hiç ifade yok. Kullanmadıklarınızı düzenlerseniz listede kaydırmak çok daha hafif olur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong %1$d danh mục, có %2$d danh mục chưa có cụm từ nào. Dọn những mục bạn không dùng sẽ giúp việc vuốt qua danh sách nhẹ hơn nhiều."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$d 个分类中有 %2$d 个没有任何快捷项。整理掉不用的，左右滑动列表会轻快很多。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$d 個分類中有 %2$d 個沒有任何快捷項。整理掉不用的，左右滑動列表會輕快很多。"
          }
        }
      }
    },
