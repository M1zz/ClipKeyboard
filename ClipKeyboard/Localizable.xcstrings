    "키캡이 생기기 전 모습이에요. 카드가 푹신하게 반응해요." : {
      "comment" : "Keyboard skin description: classic",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How it looked before keycaps. Cards respond with a soft bounce."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是有键帽之前的样子。卡片会软软地回弹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是有鍵帽之前的樣子。卡片會軟軟地回彈。"
          }
        }
      },
      "shouldTranslate" : false
    },
    "키컬러를 주황으로 바꿔 눌러야 할 곳이 분명해졌어요" : {
      "comment" : "Changelog 5.0.0 accent",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nová oranžová barva kláves jasně ukazuje, kam klepnout"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den nye orange tastefarve gør det tydeligt, hvor du skal trykke"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine neue orange Tastenfarbe zeigt klar, wo du tippen sollst"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το νέο πορτοκαλί χρώμα πλήκτρων δείχνει καθαρά πού να πατήσετε"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new orange key color makes the thing to tap obvious"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nuevo color naranja de las teclas deja claro dónde tocar"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uusi oranssi korostusväri tekee napautettavasta kohdasta selvän"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nouvelle couleur orange des touches montre clairement où appuyer"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warna tombol kini oranye, sehingga bagian yang perlu diketuk lebih jelas"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nuovo colore arancione dei tasti rende chiaro dove toccare"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーカラーをオレンジに変え、タップする場所がはっきりしました"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ny oransje tastefarge gjør det tydelig hva du skal trykke på"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een nieuwe oranje toetskleur maakt duidelijk waar je moet tikken"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomarańczowy kolor klawiszy jasno pokazuje, gdzie dotknąć"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nova cor laranja nas teclas deixa claro onde tocar"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оранжевый цвет клавиш теперь ясно показывает, куда нажимать"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tangentfärgen är nu orange, så det syns tydligt vad du ska trycka på"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สีปุ่มใหม่เป็นสีส้ม ทำให้เห็นชัดว่าต้องแตะตรงไหน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vurgu rengi turuncu oldu, dokunulacak yer artık belli"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Màu phím mới là màu cam, giúp thấy rõ chỗ cần nhấn"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主色换成橙色，该点哪里更清楚了"
          }
        },
