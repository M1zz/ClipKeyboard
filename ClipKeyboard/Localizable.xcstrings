    "고칠 곳을 빈칸으로, 실수 없이" : {
      "comment" : "Essentials card headline: office worker",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Měněné části proměňte v pole k vyplnění. Bez omylů"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gør det, du retter, til udfyldningsfelter. Uden fejl"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungen als Ausfüllfelder, ohne Fehler"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάντε πεδία συμπλήρωσης ό,τι αλλάζετε, χωρίς λάθη"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn what you edit into blanks. No slip-ups"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que editas, como campos para llenar. Sin errores"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muuta muokattavat kohdat täytettäviksi kentiksi, ilman virheitä"
