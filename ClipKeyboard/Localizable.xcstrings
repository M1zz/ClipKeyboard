        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hurtigindsætningspanelet (⌃⇧V) bliver liggende over din aktuelle app. Klik på en frase, og teksten indsættes direkte i tekstfeltet, du skrev i, uden at miste fokus."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Schnelleinfüge-Fenster (⌃⇧V) bleibt über deiner aktuellen App. Klicke auf einen Textbaustein, und der Text wird direkt in das Textfeld eingefügt, in dem du gerade schreibst, ohne den Fokus zu verlieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο πίνακας γρήγορης επικόλλησης (⌃⇧V) μένει πάνω από την τρέχουσα εφαρμογή. Κάντε κλικ σε μια φράση και το κείμενο επικολλάται απευθείας στο πεδίο όπου πληκτρολογούσατε, χωρίς να χαθεί η εστίαση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The quick paste panel (⌃⇧V) stays over your current app, click a snippet and the text is pasted directly into the text field you were typing in, without losing focus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El panel de pegado rápido (⌃⇧V) se queda sobre tu app actual. Haz clic en una frase y el texto se pega directo en el campo donde estabas escribiendo, sin perder el foco."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pikaliitospaneeli (⌃⇧V) pysyy nykyisen appin päällä. Napsauta fraasia, niin teksti liitetään suoraan kenttään, johon kirjoitit, ja kohdistin pysyy paikallaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le panneau de collage rapide (⌃⇧V) reste au-dessus de votre app actuelle. Cliquez sur une note et le texte est collé directement dans le champ où vous écriviez, sans perdre le focus."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panel tempel cepat (⌃⇧V) tetap di atas aplikasi Anda saat ini. Klik sebuah frasa dan teksnya langsung ditempel ke kolom teks yang sedang Anda ketik, tanpa kehilangan fokus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pannello di incolla rapida (⌃⇧V) resta sopra l'app in uso: clicca su una frase e il testo viene incollato direttamente nel campo in cui stavi scrivendo, senza perdere il focus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クイック貼り付けパネル(⌃⇧V)は現在のアプリの上に表示されます。定型文をクリックすると、入力中のテキスト欄にフォーカスを保ったまま直接貼り付けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The quick paste panel (⌃⇧V) stays over your current app, click a memo and the text is pasted directly into the text field you were typing in, without losing focus."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hurtiglimpanelet (⌃⇧V) ligger over appen du bruker. Klikk på en frase, så limes teksten rett inn i tekstfeltet du skrev i, uten at du mister fokus."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het snelle plakpaneel (⌃⇧V) blijft boven je huidige app staan. Klik op een fragment en de tekst wordt direct geplakt in het tekstveld waarin je aan het typen was, zonder de focus te verliezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panel szybkiego wklejania (⌃⇧V) pozostaje nad bieżącą aplikacją, kliknij frazę, a tekst trafi prosto do pola, w którym piszesz, bez utraty fokusu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O painel de colagem rápida (⌃⇧V) fica sobre o app atual. Clique em uma frase e o texto é colado direto no campo em que você estava digitando, sem perder o foco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Панель быстрой вставки (⌃⇧V) остаётся поверх текущего приложения, нажмите на фразу, и текст сразу вставится в то поле, где вы печатали, без потери фокуса."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panelen för snabb inklistring (⌃⇧V) ligger kvar över din aktuella app. Klicka på en fras så klistras texten in direkt i textfältet du skrev i, utan att fokus tappas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แผงวางด่วน (⌃⇧V) จะอยู่เหนือแอปที่คุณใช้อยู่ คลิกโน้ตแล้วข้อความจะถูกวางลงในช่องที่คุณกำลังพิมพ์ทันที โดยไม่เสียโฟกัส"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hızlı yapıştırma paneli (⌃⇧V) geçerli uygulamanızın üstünde kalır. Bir ifadeye tıklayın, metin odağı kaybetmeden yazdığınız alana doğrudan yapıştırılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bảng dán nhanh (⌃⇧V) nằm trên ứng dụng bạn đang dùng. Nhấp vào một cụm từ và văn bản sẽ được dán thẳng vào ô bạn đang nhập, không mất tiêu điểm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速粘贴面板（⌃⇧V）会浮在当前 App 上方，点一个短语，文字就直接粘到你刚才输入的文本框里，焦点不会丢。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
