    "Copied Stripe URLs are auto-tagged as \"URL\". Pull them up anytime from the clipboard history." : {
      "comment" : "Smart clipboard hint: Stripe URL auto-tag",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkopírované URL ze Stripe se automaticky označí jako \"URL\". Z historie schránky je kdykoli znovu vyberete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopierede Stripe URL'er tagges automatisk som \"URL\". Du kan hente dem igen når som helst fra historikken for udklipsholder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
