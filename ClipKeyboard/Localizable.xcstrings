        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เราจะถามเรื่องเพอร์โซนาหลังจากที่คุณลองใช้แอปแล้ว ไม่ใช่ในหน้าแรก และถามเพียงครั้งเดียว เมื่อสร้างข้อความด่วนครบสองรายการหรือสร้างหมวดหมู่หนึ่งหมวด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persona sorusunu ilk ekranda değil, uygulamayı kullandıktan sonra soruyoruz. İki ifade ya da bir kategori oluşturduğunuzda yalnızca bir kez"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chúng tôi hỏi về persona sau khi bạn đã dùng thử, không hỏi ngay màn hình đầu. Chỉ một lần, sau khi bạn tạo hai cụm từ hoặc một danh mục"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
