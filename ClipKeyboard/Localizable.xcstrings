    "보안 단축어로 설정했어요" : {
      "comment" : "Memo locked toast",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snippet locked"
          }
