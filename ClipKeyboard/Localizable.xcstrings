        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα δημιουργήσουμε εκ των προτέρων τις κατηγορίες που χρησιμοποιείτε συχνά. Μπορείτε να τις αλλάξετε ανά πάσα στιγμή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We will preset commonly-used categories for you. You can change them anytime."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crearemos de antemano las categorías más usadas. Puedes cambiarlas cuando quieras."
