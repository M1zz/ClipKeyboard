    "지금 로그인한 Apple ID 로 Pro 를 구매한 기록을 찾지 못했어요. 구매할 때 쓴 Apple ID 로 로그인했는지 확인해 주세요." : {
      "comment" : "Restore result message: no Pro purchase found for this Apple ID",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenašli jsme nákup Pro pro přihlášené Apple ID. Zkontrolujte, zda jste přihlášeni s Apple ID, kterým jste nákup provedli."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi kunne ikke finde et Pro-køb for det Apple-ID, du er logget ind med. Kontrollér, at du er logget ind med det Apple-ID, du købte det med."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die aktuell angemeldete Apple ID wurde kein Kauf von Pro gefunden. Bitte prüfe, ob du mit der Apple ID angemeldet bist, die du beim Kauf verwendet hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν βρέθηκε αγορά του Pro για το Apple ID με το οποίο έχετε συνδεθεί. Βεβαιωθείτε ότι έχετε συνδεθεί με το Apple ID που χρησιμοποιήσατε για την αγορά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We couldn't find a Pro purchase for the Apple ID you're signed in with. Please make sure you're signed in with the Apple ID you used to buy it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No encontramos una compra de Pro con el Apple ID que tienes abierto. Revisa que hayas iniciado sesión con el Apple ID que usaste para comprarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjautuneen Apple ID:n Pro-ostoa ei löytynyt. Tarkista, että olet kirjautunut ostossa käyttämälläsi Apple ID:llä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun achat de Pro n'a été trouvé pour l'identifiant Apple connecté. Vérifiez que vous utilisez celui de votre achat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami tidak menemukan pembelian Pro di Apple ID yang sedang Anda gunakan. Pastikan Anda masuk dengan Apple ID yang dipakai saat membeli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non abbiamo trovato un acquisto di Pro per l'Apple ID con cui hai effettuato l'accesso. Controlla di aver effettuato l'accesso con l'Apple ID usato per l'acquisto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインイン中のApple IDでは、Proの購入履歴が見つかりませんでした。購入時に使ったApple IDでサインインしているか、ご確認ください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi fant ingen Pro-kjøp for Apple ID-en du er logget inn med. Sjekk at du bruker den Apple ID-en du kjøpte med."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is geen Pro-aankoop gevonden voor de Apple ID waarmee je nu bent ingelogd. Controleer of je bent ingelogd met de Apple ID die je bij de aankoop gebruikte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie znaleziono zakupu Pro dla zalogowanego Apple ID. Sprawdź, czy używasz Apple ID z zakupu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não encontramos uma compra do Pro no Apple ID em que você está conectado. Verifique se entrou com o Apple ID usado na compra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось найти покупку Pro для текущего Apple ID. Убедитесь, что вы вошли с тем Apple ID, который использовали при покупке."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi hittade inget Pro-köp för det Apple-ID som du är inloggad med. Kontrollera att du är inloggad med det Apple-ID som du köpte med."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่พบประวัติการซื้อ Pro ด้วย Apple ID ที่ลงชื่อเข้าใช้อยู่ โปรดตรวจสอบว่าลงชื่อเข้าใช้ด้วย Apple ID ที่ใช้ซื้อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giriş yaptığınız Apple ID ile Pro satın alımı bulunamadı. Satın alırken kullandığınız Apple ID ile giriş yaptığınızdan emin olun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chúng tôi không tìm thấy giao dịch mua Pro nào với Apple ID bạn đang đăng nhập. Hãy kiểm tra xem bạn đã đăng nhập bằng Apple ID dùng để mua chưa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未找到当前登录的 Apple ID 购买 Pro 的记录。请确认你登录的是购买时使用的 Apple ID。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未找到當前登入的 Apple ID 購買 Pro 的記錄。請確認你登入的是購買時使用的 Apple ID。"
          }
        }
      }
    },
