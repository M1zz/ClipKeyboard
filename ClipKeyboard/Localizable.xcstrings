        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa có lịch sử thay đổi. Khi bạn thêm, sửa hoặc xóa cụm từ, trạng thái trước đó sẽ tự động được lưu ở đây (10 lần gần nhất)."
          }
