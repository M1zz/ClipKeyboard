          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение стало быстрее. Задержка при запуске исчезла, а работа в первые десять секунд сократилась вдвое."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
