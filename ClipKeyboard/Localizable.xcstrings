    "ClipKeyboard needs Accessibility permission to register global shortcuts. Grant access in System Settings → Privacy & Security → Accessibility." : {
      "comment" : "Auto-registered",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipKeyboard potřebuje oprávnění Zpřístupnění, aby mohl registrovat globální zkratky. Povolte přístup v Nastavení systému → Soukromí a zabezpečení → Zpřístupnění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipKeyboard skal have tilladelse til Tilgængelighed for at registrere globale genveje. Giv adgang i Systemindstillinger → Anonymitet og sikkerhed → Tilgængelighed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipKeyboard braucht die Berechtigung für Bedienungshilfen, um globale Kurzbefehle zu registrieren. Erlaube den Zugriff unter Systemeinstellungen → Datenschutz & Sicherheit → Bedienungshilfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ClipKeyboard χρειάζεται άδεια Προσβασιμότητας για να καταχωρίσει καθολικές συντομεύσεις. Δώστε πρόσβαση στις Ρυθμίσεις συστήματος → Απόρρητο και ασφάλεια → Προσβασιμότητα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipKeyboard needs Accessibility permission to register global shortcuts. Grant access in System Settings → Privacy & Security → Accessibility."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipKeyboard necesita permiso de Accesibilidad para registrar atajos globales. Concede el acceso en Ajustes del Sistema → Privacidad y seguridad → Accesibilidad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipKeyboard tarvitsee Esteettömyys-luvan yleisten pikanäppäinten rekisteröintiin. Myönnä lupa: Järjestelmäasetukset → Tietosuoja ja turvallisuus → Esteettömyys."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipKeyboard a besoin de l'autorisation d'accessibilité pour enregistrer des raccourcis globaux. Autorisez l'accès dans Réglages Système → Confidentialité et sécurité → Accessibilité."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipKeyboard memerlukan izin Aksesibilitas untuk mendaftarkan pintasan global. Berikan akses di Pengaturan Sistem → Privasi & Keamanan → Aksesibilitas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipKeyboard ha bisogno dell'autorizzazione Accessibilità per registrare le scorciatoie globali. Concedi l'accesso in Impostazioni di Sistema → Privacy e sicurezza → Accessibilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipKeyboardでグローバルショートカットを登録するには、アクセシビリティの許可が必要です。システム設定 → プライバシーとセキュリティ → アクセシビリティで許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipKeyboard needs Accessibility permission to register global shortcuts. Grant access in System Settings → Privacy & Security → Accessibility."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipKeyboard trenger tilgang til tilgjengelighet for å registrere globale snarveier. Gi tilgang i Systeminnstillinger → Personvern og sikkerhet → Tilgjengelighet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipKeyboard heeft toegang via Toegankelijkheid nodig om globale sneltoetsen te registreren. Geef toegang in Systeeminstellingen → Privacy en beveiliging → Toegankelijkheid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipKeyboard potrzebuje uprawnienia Dostępność, aby rejestrować globalne skróty. Przyznaj dostęp w Ustawienia systemowe → Prywatność i ochrona → Dostępność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ClipKeyboard precisa de permissão de Acessibilidade para registrar atalhos globais. Conceda o acesso em Ajustes do Sistema → Privacidade e Segurança → Acessibilidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipKeyboard нужен доступ Accessibility для регистрации глобальных сочетаний клавиш. Предоставьте доступ в Системных настройках → Конфиденциальность и безопасность → Универсальный доступ."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipKeyboard behöver behörighet för hjälpmedel för att registrera globala genvägar. Ge åtkomst i Systeminställningar → Integritet och säkerhet → Hjälpmedel."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipKeyboard ต้องได้รับสิทธิ์การช่วยการเข้าถึงเพื่อลงทะเบียนทางลัดส่วนกลาง ให้สิทธิ์ได้ที่ การตั้งค่าระบบ → ความเป็นส่วนตัวและความปลอดภัย → การช่วยการเข้าถึง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipKeyboard'un genel kısayolları kaydedebilmesi için Erişilebilirlik izni gerekir. Sistem Ayarları → Gizlilik ve Güvenlik → Erişilebilirlik bölümünden izin verin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipKeyboard cần quyền Trợ năng để đăng ký phím tắt toàn cục. Hãy cấp quyền trong Cài đặt hệ thống → Quyền riêng tư & Bảo mật → Trợ năng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "剪贴键盘需要辅助功能权限才能注册全局快捷键。请在“系统设置 → 隐私与安全性 → 辅助功能”中授权。"
