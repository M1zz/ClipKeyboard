    "필요한 기능이나 불편했던 점을 남겨주시면 개발자가 직접 읽고 반드시 해결해 드릴게요." : {
      "comment" : "Feedback nudge message",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napište nám, co potřebujete nebo co vám vadí: vývojář každou zprávu čte a postará se o nápravu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortæl os, hvad du mangler, eller hvad der er besværligt: Udvikleren læser alt og får det rettet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreib uns, was dir fehlt oder was dich stört: Der Entwickler liest jede Nachricht und kümmert sich darum."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πείτε μας τι χρειάζεστε ή τι σας δυσκόλεψε. Ο προγραμματιστής διαβάζει κάθε μήνυμα και θα το φροντίσει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell us what you need or what's inconvenient: the developer reads every message and will make it right."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuéntanos qué función necesitas o qué te incomodó: el desarrollador lee cada mensaje y lo resolverá."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerro, mitä tarvitset tai mikä on hankalaa. Kehittäjä lukee jokaisen viestin ja korjaa asian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites-nous ce dont vous avez besoin ou ce qui vous gêne. Le développeur lit chaque message et fera le nécessaire."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuliskan kebutuhan atau kendala Anda. Pengembang membaca langsung dan pasti akan menanganinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dicci di cosa hai bisogno o cosa non ti convince: lo sviluppatore legge ogni messaggio e lo risolverà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要な機能や不便だった点を送っていただければ、開発者が直接読んで、必ず対応します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortell oss hva du trenger eller hva som er tungvint. Utvikleren leser alt og ordner det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat weten wat je nodig hebt of wat niet fijn werkte: de ontwikkelaar leest elk bericht en lost het op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napisz, czego potrzebujesz lub co Ci przeszkadza. Twórca czyta każdą wiadomość i na pewno to naprawi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conte o que você precisa ou o que atrapalhou. O desenvolvedor lê cada mensagem e vai resolver."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напишите, чего не хватает или что неудобно: разработчик читает каждое сообщение и обязательно всё исправит."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berätta vad du behöver eller vad som känns besvärligt: utvecklaren läser allt och löser det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บอกเราว่าต้องการอะไรหรือติดขัดตรงไหน ผู้พัฒนาอ่านทุกข้อความและจะแก้ไขให้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İhtiyacınız olan özelliği ya da zorlandığınız noktayı yazın: geliştirici her mesajı okur ve mutlaka çözer."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy cho chúng tôi biết bạn cần gì hoặc điều gì chưa tiện. Nhà phát triển sẽ đọc từng tin nhắn và xử lý cho bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把你需要的功能或者用着不顺的地方写下来，开发者会亲自读，并且一定给你解决。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把你需要的功能或者用著不順的地方寫下來，開發者會親自讀，並且一定給你解決。"
          }
        }
      }
    },
