    },
    "추천 카테고리가 추가돼요. 처음엔 꺼져 있으니 카테고리 관리에서 원하는 것만 켜세요." : {
      "comment" : "Persona settings subtitle",
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doporučené kategorie se přidají. Nejdřív jsou vypnuté, v části Správa kategorií zapněte jen ty, které chcete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anbefalede kategorier tilføjes. De er slået fra i starten, så slå kun dem til, du vil have, i Administrer kategorier."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empfohlene Kategorien werden hinzugefügt. Sie sind zunächst aus, schalte in der Kategorienverwaltung nur ein, was du willst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προστίθενται προτεινόμενες κατηγορίες. Αρχικά είναι ανενεργές, οπότε ενεργοποιήστε στη διαχείριση κατηγοριών μόνο όσες θέλετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recommended categories are added: off at first, so turn on only the ones you want in Manage Categories."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se agregan categorías recomendadas. Empiezan desactivadas, así que activa solo las que quieras en Administrar categorías."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suositellut kategoriat lisätään. Ne ovat aluksi pois päältä, joten ota käyttöön vain haluamasi kategoriahallinnassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des catégories recommandées sont ajoutées. Elles sont désactivées au départ : activez seulement celles qui vous conviennent dans Gérer les catégories."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kategori yang disarankan akan ditambahkan. Awalnya nonaktif, jadi aktifkan saja yang Anda mau di Kelola Kategori."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono aggiunte categorie consigliate, disattivate all'inizio: attiva solo quelle che vuoi in Gestisci categorie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おすすめのカテゴリが追加されます。最初はオフなので、カテゴリ管理で必要なものだけオンにしてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anbefalte kategorier legges til. De er av i starten, så slå på bare de du vil ha i Administrer kategorier."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aanbevolen categorieën worden toegevoegd. Ze staan eerst uit, dus zet in Beheer categorieën alleen aan wat je wilt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polecane kategorie zostaną dodane. Na początku są wyłączone, więc włącz w Zarządzaniu kategoriami tylko te, które chcesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Categorias recomendadas são adicionadas. Elas começam desativadas, então ative em Gerenciar categorias só as que quiser."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляются рекомендуемые категории. Сначала они выключены, включите нужные в разделе «Управление категориями»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rekommenderade teman läggs till. De är avstängda från början, så slå på bara de du vill ha under Hantera teman."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระบบจะเพิ่มหมวดหมู่ที่แนะนำ โดยปิดไว้ก่อน เปิดเฉพาะที่ต้องการได้ในจัดการหมวดหมู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önerilen kategoriler eklenir. Başta kapalıdır, Kategorileri Yönet'ten istediklerinizi açın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các danh mục đề xuất sẽ được thêm và tắt sẵn. Hãy bật những mục bạn muốn trong phần Quản lý danh mục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
