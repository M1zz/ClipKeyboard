      "comment" : "Changelog 5.0.1 reconcile",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpis v záznamu nově ukazuje i odečtený čas, takže řádky dávají dohromady číslo nad nimi."
