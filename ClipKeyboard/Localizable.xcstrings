    "저장 버튼에 지금 복사해 둔 글이 미리 보여요. 카드번호는 끝 네 자리만 보여요." : {
      "comment" : "What's new 5.1.8 save preview detail",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tlačítko uložení zobrazí zkopírovaný text. U čísel karet jsou vidět jen poslední čtyři číslice."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem-knappen viser den tekst, du har kopieret. Kortnumre viser kun de sidste fire cifre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sichern-Taste zeigt den kopierten Text. Bei Kartennummern siehst du nur die letzten vier Ziffern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το κουμπί αποθήκευσης δείχνει το κείμενο που αντιγράψατε. Οι αριθμοί καρτών δείχνουν μόνο τα τέσσερα τελευταία ψηφία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The save button shows the text you copied. Card numbers show only the last four digits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El botón de guardar muestra el texto que copiaste. De las tarjetas solo se ven los últimos cuatro dígitos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallenna-painike näyttää kopioimasi tekstin. Korttinumerosta näkyy vain neljä viimeistä numeroa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bouton Enregistrer affiche le texte copié. Pour les numéros de carte, seuls les quatre derniers chiffres sont visibles."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tombol simpan menampilkan teks yang Anda salin. Nomor kartu hanya menampilkan empat digit terakhir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pulsante Salva mostra il testo copiato. Dei numeri di carta si vedono solo le ultime quattro cifre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存ボタンに、いまコピーしている文章が表示されます。カード番号は下4桁のみ表示されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagre-knappen viser teksten du kopierte. Kortnumre viser bare de fire siste sifrene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De bewaarknop toont de tekst die je hebt gekopieerd. Bij kaartnummers zie je alleen de laatste vier cijfers."
          }
