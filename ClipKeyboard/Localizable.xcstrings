    "실제로 돈을 낸 비율이에요. 새 플래그를 보낸 기기만 셉니다." : {
      "comment" : "Marketing hint: paid",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podíl těch, kteří skutečně zaplatili. Počítají se jen zařízení, která odeslala nové příznaky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andelen, der faktisk har betalt. Tæller kun enheder, der har sendt de nye flag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anteil, der wirklich bezahlt hat. Gezählt werden nur Geräte, die die neuen Flags gesendet haben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ποσοστό όσων πλήρωσαν πραγματικά. Μετράει μόνο συσκευές που έστειλαν τις νέες σημαίες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The share who actually paid. Counts only devices that reported the new flags."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es el porcentaje que sí pagó. Solo cuenta los dispositivos que enviaron las nuevas marcas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksaneiden osuus. Laskee vain laitteet, jotka lähettivät uudet liput."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La part de ceux qui ont réellement payé. Seuls les appareils ayant envoyé les nouveaux indicateurs sont comptés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persentase yang benar-benar membayar. Hanya menghitung perangkat yang mengirim flag baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La percentuale di chi ha pagato davvero. Conta solo i dispositivi che hanno inviato i nuovi flag."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実際に支払った割合です。新しいフラグを送信した端末のみ集計します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andelen som faktisk har betalt. Teller bare enheter som har sendt de nye flaggene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het aandeel dat echt heeft betaald. Telt alleen apparaten die de nieuwe vlaggen hebben doorgegeven."
          }
        },
