        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes cambiar el nombre de un campo. También cambia en las frases que lo usan, y antes te mostramos cuántas son"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力欄の名前を変更できます。その名前を使う定型文の内容も一緒に変わり、変更される件数を先にお見せします"
