    "며칠 써 보신 뒤부터 복사한 내용을 자동으로 모아요.\n그때 iOS가 붙여넣기를 허용할지 한 번 물어봐요." : {
      "comment" : "Clipboard history empty description during warm-up",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkopírované položky začneme shromažďovat po několika dnech používání.\nTehdy se iOS jednou zeptá, zda povolit vkládání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi begynder at samle det, du kopierer, efter du har brugt appen i nogle dage.\niOS spørger så én gang, om indsættelse må tillades."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach ein paar Tagen Nutzung sammle ich automatisch, was du kopierst.\nDann fragt iOS einmal, ob das Einfügen erlaubt ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετά από λίγες μέρες χρήσης αρχίζουμε να συγκεντρώνουμε ό,τι αντιγράφετε.\nΤότε το iOS θα ρωτήσει μία φορά αν επιτρέπεται η επικόλληση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We start collecting what you copy after you've used the app for a few days.\niOS will ask once then whether to allow pasting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empezamos a guardar lo que copias después de unos días de uso.\nEntonces iOS te preguntará una vez si permites pegar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alamme kerätä kopioimaasi sisältöä, kun olet käyttänyt sovellusta muutaman päivän.\niOS kysyy silloin kerran, sallitaanko liittäminen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous commençons à collecter ce que vous copiez après quelques jours d'utilisation.\niOS vous demandera alors une fois d'autoriser le collage."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami mulai mengumpulkan salinan Anda setelah aplikasi dipakai beberapa hari.\niOS akan bertanya sekali apakah penempelan diizinkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniziamo a raccogliere ciò che copi dopo qualche giorno di utilizzo.\nAllora iOS ti chiederà una volta se consentire l'incolla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使い始めて数日後から、コピーした内容を自動で集めます。\nそのとき、iOSがペーストを許可するか一度確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "며칠 써 보신 뒤부터 복사한 내용을 자동으로 모아요.\n그때 iOS가 붙여넣기를 허용할지 한 번 물어봐요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi begynner å samle det du kopierer etter at du har brukt appen noen dager.\niOS spør da én gang om du vil tillate liming."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na een paar dagen gebruik verzamelen we automatisch wat je kopieert.\nDan vraagt iOS één keer of plakken is toegestaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaczniemy zbierać skopiowane treści po kilku dniach korzystania z aplikacji.\nWtedy iOS zapyta raz, czy zezwolić na wklejanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de alguns dias de uso, começamos a reunir o que você copia.\nNa hora, o iOS pergunta uma vez se permite colar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы начнём собирать скопированное через несколько дней использования.\nТогда iOS один раз спросит, разрешить ли вставку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi börjar samla det du kopierar efter några dagars användning.\niOS frågar då en gång om inklistring ska tillåtas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แอปจะเริ่มเก็บสิ่งที่คัดลอกหลังใช้งานไปสองสามวัน\nตอนนั้น iOS จะถามหนึ่งครั้งว่าอนุญาตการวางหรือไม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birkaç gün kullandıktan sonra kopyaladıklarınızı otomatik toplamaya başlarız.\niOS o sırada yapıştırmaya izin verip vermeyeceğinizi bir kez sorar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau vài ngày dùng, ứng dụng sẽ tự động thu thập nội dung bạn sao chép.\nKhi đó iOS sẽ hỏi một lần xem có cho phép dán không."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用本应用几天后，我们才会开始收集你复制的内容。\niOS 届时会询问一次是否允许粘贴。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用本應用幾天後，我們才會開始收集你複製的內容。\niOS 屆時會詢問一次是否允許貼上。"
          }
        }
      }
    },
