        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las categorías ya no se multiplican solas. Solo aparecen cuando tú creas una"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カテゴリが勝手に増えることはなくなりました。ご自身で作成したときだけ増えます"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
