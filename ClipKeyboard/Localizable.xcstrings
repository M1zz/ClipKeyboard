      "shouldTranslate" : false
    },
    "1년마다 %@씩 자동으로 갱신돼요. 갱신 24시간 전까지 설정 > Apple 계정 > 구독에서 해지할 수 있어요." : {
      "comment" : "Yearly subscription terms",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnovuje se automaticky za %@ ročně. Zrušit lze nejpozději 24 hodin před obnovením v Nastavení > Účet Apple > Předplatná."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fornyes automatisk for %@ om året. Opsig senest 24 timer før fornyelse i Indstillinger > Apple-konto > Abonnementer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlängert sich jährlich automatisch für %@. Bis 24 Stunden vor der Verlängerung kannst du in Einstellungen > Apple-Account > Abos kündigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανανεώνεται αυτόματα με %@ ανά έτος. Ακύρωση τουλάχιστον 24 ώρες πριν την ανανέωση, από Ρυθμίσεις > Λογαριασμός Apple > Συνδρομές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renews automatically at %@ per year. Cancel at least 24 hours before renewal in Settings > Apple Account > Subscriptions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se renueva automáticamente cada año por %@. Cancela al menos 24 horas antes de la renovación en Ajustes > Cuenta de Apple > Suscripciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uusiutuu automaattisesti hintaan %@ vuodessa. Peruuta viimeistään 24 tuntia ennen uusiutumista kohdassa Asetukset > Apple-tili > Tilaukset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renouvellement automatique à %@ par an. Annulez au moins 24 heures avant le renouvellement dans Réglages > Compte Apple > Abonnements."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diperpanjang otomatis dengan biaya %@ per tahun. Batalkan paling lambat 24 jam sebelum perpanjangan di Pengaturan > Akun Apple > Langganan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si rinnova automaticamente a %@ all'anno. Annulla almeno 24 ore prima del rinnovo in Impostazioni > Account Apple > Abbonamenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1年ごとに%@で自動更新されます。更新の24時間前までに、設定 > Apple アカウント > サブスクリプションで解約できます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fornyes automatisk hvert år til %@. Du kan si opp i Innstillinger > Apple-konto > Abonnementer senest 24 timer før fornyelsen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt elk jaar automatisch verlengd voor %@. Zeg op in Instellingen > Apple Account > Abonnementen, uiterlijk 24 uur voor verlenging."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odnawia się automatycznie za %@ rocznie. Anuluj co najmniej 24 godziny przed odnowieniem w Ustawienia > Konto Apple > Subskrypcje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renova automaticamente por %@ ao ano. Cancele até 24 horas antes da renovação em Ajustes > Conta Apple > Assinaturas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продлевается автоматически за %@ в год. Отменить можно не позднее чем за 24 часа до продления: Настройки > Учётная запись Apple > Подписки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förnyas automatiskt för %@ per år. Avsluta senast 24 timmar före förnyelsen i Inställningar > Apple-konto > Prenumerationer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต่ออายุอัตโนมัติทุกปีในราคา %@ ยกเลิกได้ก่อนต่ออายุอย่างน้อย 24 ชั่วโมงที่ การตั้งค่า > บัญชี Apple > การสมัครสมาชิก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yılda %@ tutarıyla otomatik yenilenir. Yenilemeden en az 24 saat önce Ayarlar > Apple Hesabı > Abonelikler bölümünden iptal edebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự động gia hạn với giá %@ mỗi năm. Hủy ít nhất 24 giờ trước khi gia hạn trong Cài đặt > Tài khoản Apple > Đăng ký."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每年自动续订 %@。可在续订前 24 小时于“设置 > Apple 账户 > 订阅”中取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每年自動續訂 %@。可在續訂前 24 小時於「設定 > Apple 帳戶 > 訂閱」中取消。"
          }
        }
      }
    },
    "1분·5분·한 시간처럼 눈에 잡히는 만큼 아끼면 알려드려요" : {
      "comment" : "Changelog 5.0.0 item 5",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozorníme vás, když ušetříte minutu, pět minut nebo hodinu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi giver besked, når du sparer et minut, fem minutter eller en time"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir sagen dir Bescheid, wenn du eine Marke erreichst, etwa eine Minute, fünf Minuten oder eine Stunde"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα σας ενημερώσουμε όταν εξοικονομήσετε ένα λεπτό, πέντε λεπτά ή μία ώρα"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We'll tell you when you hit a milestone like a minute, five minutes, or an hour"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te avisaremos cuando llegues a una meta, como un minuto, cinco minutos o una hora"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmoitamme, kun säästät kokonaisen minuutin, viisi minuuttia tai tunnin"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous vous prévenons quand vous atteignez une étape : une minute, cinq minutes ou une heure"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami beri tahu saat Anda menghemat 1 menit, 5 menit, atau satu jam"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti avvisiamo quando raggiungi un traguardo, come un minuto, cinque minuti o un'ora"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1分・5分・1時間など、節約できた時間の節目でお知らせします"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du får beskjed når du har spart et minutt, fem minutter eller en time"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We laten het je weten bij een mijlpaal, zoals een minuut, vijf minuten of een uur bespaard"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiadomimy Cię, gdy zaoszczędzisz minutę, pięć minut albo godzinę"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisamos quando você chegar a um marco, como um minuto, cinco minutos ou uma hora"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщим, когда сэкономите заметное время: минуту, пять минут или час"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi säger till när du når ett delmål, som en minut, fem minuter eller en timme"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เราจะแจ้งเมื่อคุณประหยัดเวลาได้ถึงระดับหนึ่ง เช่น 1 นาที 5 นาที หรือ 1 ชั่วโมง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir dakika, beş dakika ya da bir saat gibi dönüm noktalarına ulaşınca haber veririz"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chúng tôi sẽ báo khi bạn đạt mốc như một phút, năm phút hoặc một giờ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "省下 1 分钟、5 分钟、1 小时这种看得见的量时，我们会告诉你"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "省下 1 分鐘、5 分鐘、1 小時這種看得見的量時，我們會告訴你"
          }
        }
      }
