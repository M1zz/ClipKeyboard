    "결제·그랜드파더·체험을 모두 포함해 Pro 기능이 열려 있는 비율이에요. 결제율이 아닙니다." : {
      "comment" : "Marketing hint: access",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podíl uživatelů s odemčenými funkcemi Pro, včetně nákupů, původních uživatelů a zkušební verze. Nejde o podíl plateb."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andelen med Pro-funktioner låst op, både køb, tidlige brugere og prøveperioder. Det er ikke købsraten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anteil mit freigeschalteten Pro-Funktionen, inklusive Käufen, Altnutzern und Testphasen. Das ist nicht die Kaufquote."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ποσοστό με ανοιχτές λειτουργίες Pro, μαζί με αγορές, χρήστες με παλιά πρόσβαση και δοκιμές. Δεν είναι το ποσοστό αγορών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The share with Pro features unlocked, including purchases, grandfathered users and trials. This is not the purchase rate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porcentaje con funciones Pro activas, incluyendo compras, acceso heredado y pruebas. No es la tasa de compra."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osuus, jolla Pro-ominaisuudet ovat auki, mukaan lukien ostot, vanhat oikeudet ja kokeilut. Tämä ei ole ostoprosentti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Part des utilisateurs dont les fonctions Pro sont ouvertes, achats, anciens utilisateurs et essais compris. Ce n'est pas le taux d'achat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persentase yang fitur Pro-nya terbuka, termasuk pembelian, pengguna lama (grandfathered), dan masa uji coba. Ini bukan tingkat pembelian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La quota di utenti con le funzioni Pro attive, inclusi acquisti, utenti storici e prove. Non è il tasso di acquisto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購入・以前からの利用・体験を含め、Pro機能が使える割合です。購入率ではありません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andelen med åpne Pro-funksjoner, inkludert kjøp, tidlige brukere og prøveperioder. Dette er ikke kjøpsraten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het aandeel waarvoor Pro-functies openstaan, inclusief aankopen, grandfathered gebruikers en proefperiodes. Dit is niet het aankooppercentage."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odsetek użytkowników z odblokowanymi funkcjami Pro, razem z zakupami, kontami grandfathered i okresem próbnym. To nie jest wskaźnik zakupów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A parcela com recursos Pro liberados, incluindo compras, usuários antigos e testes. Não é a taxa de compra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доля с открытыми функциями Pro: покупки, сохранённый доступ и пробный период. Это не доля оплаты."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andelen med Pro-funktioner upplåsta, inklusive köp, tidiga användare och prov. Det är inte köpandelen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สัดส่วนผู้ที่ปลดล็อกฟีเจอร์ Pro รวมการซื้อ ผู้ใช้กลุ่มเดิม และช่วงทดลองใช้ ไม่ใช่อัตราการซื้อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satın alma, eski sürüm hakkı ve deneme dahil Pro özelliklerinin açık olduğu kullanıcı oranıdır. Satın alma oranı değildir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tỷ lệ bạn dùng được tính năng Pro, gồm cả mua, người dùng cũ được miễn phí và dùng thử. Đây không phải tỷ lệ thanh toán."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包含付费、老用户保留和体验在内，Pro 功能已开启的比例。这不是付费率。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包含付費、老使用者保留和體驗在內，Pro 功能已開啓的比例。這不是付費率。"
          }
        }
      }
