    "한 번 꺼내 쓸 때마다 적어도 2분은 아낀 것으로 세요. 깃 토큰처럼 갈래를 못 알아보는 값이 10초로 적히던 걸 고쳤어요" : {
      "comment" : "Changelog 5.0.1 baseline",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každé použití se počítá jako úspora alespoň 2 minut. Hodnoty, které nelze zařadit, třeba git token, se dřív zapisovaly jako 10 sekund."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver brug tæller nu som mindst 2 minutters tidsbesparelse. Værdier, vi ikke kan afgøre, som et git-token, blev før regnet som 10 sekunder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Nutzung zählt jetzt als mindestens 2 Minuten gespart. Werte, die wir nicht einordnen können, etwa ein Git-Token, wurden vorher mit 10 Sekunden erfasst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε χρήση μετράει πλέον τουλάχιστον 2 λεπτά που εξοικονομήσατε. Τιμές που δεν αναγνωρίζονταν, όπως ένα διακριτικό git, καταγράφονταν ως 10 δευτερόλεπτα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every use now counts as at least 2 minutes saved. Values we can't classify, like a git token, used to be logged as 10 seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada vez que usas una frase cuenta como mínimo 2 minutos ahorrados. Corregimos que valores como un token de git se registraran como 10 segundos"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokainen käyttökerta lasketaan vähintään 2 minuutin säästöksi. Arvot, joita ei tunnistettu, kuten git-tunnus, kirjattiin ennen 10 sekunniksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque utilisation compte désormais pour au moins 2 minutes gagnées. Les valeurs non classables, comme un jeton git, étaient comptées pour 10 secondes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap pemakaian kini dihitung hemat minimal 2 menit. Nilai yang tidak bisa dikategorikan, seperti token git, dulu tercatat 10 detik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni uso conta ora come almeno 2 minuti risparmiati. I valori che non riusciamo a classificare, come un token git, venivano registrati come 10 secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1回使うごとに、最低2分の節約として数えます。Gitトークンのように種類を判別できない値が10秒と記録されていた問題を修正しました"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver bruk teller nå som minst 2 minutter spart. Verdier vi ikke kan klassifisere, som et git-token, ble tidligere logget som 10 sekunder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk gebruik telt nu als minstens 2 minuten bespaard. Waarden die we niet kunnen indelen, zoals een git-token, werden eerder als 10 seconden geteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde użycie liczy się teraz jako co najmniej 2 minuty oszczędności. Wartości, których nie da się sklasyfikować, np. token gita, były liczone jako 10 sekund."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada uso agora conta como no mínimo 2 minutos economizados. Valores que não conseguimos classificar, como um token do git, eram registrados como 10 segundos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теперь каждое использование засчитывается минимум как 2 минуты экономии. Раньше значения, которые не удавалось распознать, например git-токен, засчитывались всего в 10 секунд"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje användning räknas nu som minst 2 minuter sparad tid. Värden som vi inte kan klassificera, som en git-token, loggades förut som 10 sekunder."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกครั้งที่ใช้ นับว่าประหยัดอย่างน้อย 2 นาที ค่าที่จัดกลุ่มไม่ได้ เช่น โทเคน git เคยบันทึกเป็น 10 วินาที ตอนนี้แก้แล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her kullanım artık en az 2 dakika tasarruf sayılır. Git belirteci gibi sınıflandıramadığımız değerler 10 saniye olarak kaydediliyordu, düzelttik."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi lần dùng được tính là tiết kiệm ít nhất 2 phút. Các giá trị không phân loại được, như biến git, trước đây bị ghi là 10 giây"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在每用一次至少算省下 2 分钟。像 git 令牌这种认不出类别的值，以前只记 10 秒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
