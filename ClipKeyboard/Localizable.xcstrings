            "value" : "Twórz własne formaty daty i godziny. Dotknij elementów, a dzisiejsza data od razu pokaże się w tym kształcie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie seus próprios formatos de data e hora. Toque nas partes e a data de hoje aparece nesse formato na hora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройте свой формат даты и времени. Нажимайте на фрагменты, и сегодняшняя дата сразу покажется в этом виде."
          }
        },
        "sv" : {
          "stringUnit" : {
