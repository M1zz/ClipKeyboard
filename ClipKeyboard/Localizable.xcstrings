    "체크 도장은 언제나 연두예요. 축하 카드의 도장만 혼자 키 컬러를 따라가고 있었어요" : {
      "comment" : "Changelog 5.0.4 green seal",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Značka zaškrtnutí je vždy žlutozelená. Jen razítko na gratulační kartě stále sledovalo hlavní barvu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flueben-stemplet er altid lysegrønt. Kun stemplet på fejringskortet fulgte stadig nøglefarven"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Häkchen-Siegel ist immer gelbgrün. Nur das auf der Glückwunschkarte folgte noch der Akzentfarbe"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σφραγίδα επιλογής είναι πάντα λαχανί. Μόνο αυτή στην κάρτα συγχαρητηρίων ακολουθούσε ακόμα το βασικό χρώμα"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The check seal is always yellow green. The one on the celebration card was the only place still following the key color"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La marca de verificación siempre es verde lima. Solo la de la tarjeta de celebración seguía tu color principal"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valintamerkin leima on aina limenvihreä. Vain juhlakortin leima seurasi vielä avainväriä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tampon de validation est toujours vert clair. Celui de la carte de félicitations était le seul à suivre encore la couleur principale"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stempel centang selalu hijau muda. Hanya stempel di kartu perayaan yang masih mengikuti warna utama"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il segno di spunta è sempre verde lime. Solo quello nella scheda di congratulazioni seguiva ancora il colore principale"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チェックのスタンプはいつも黄緑です。お祝いカードのスタンプだけ、キーカラーに合わせていました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "체크 도장은 언제나 연두예요. 축하 카드의 도장만 혼자 키 컬러를 따라가고 있었어요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avkrysningsstempelet er alltid gulgrønt. Det på feiringskortet var det eneste stedet som fortsatt fulgte nøkkelfargen"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het vinkje is altijd geelgroen. Alleen het vinkje op de felicitatiekaart volgde nog de accentkleur"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znacznik jest zawsze limonkowy. Tylko na karcie gratulacji podążał jeszcze za kolorem wiodącym"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O selo de confirmação é sempre verde-limão. Só o do cartão de comemoração ainda seguia a cor principal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Печать с галочкой всегда салатовая. Только на карточке поздравления она почему-то следовала за основным цветом"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bockstämpeln är alltid gulgrön. Det var bara stämpeln på gratulationskortet som fortfarande följde nyckelfärgen"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตราเช็กเป็นสีเขียวอ่อนเสมอ เฉพาะการ์ดฉลองที่ยังเปลี่ยนตามสีหลัก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onay mührü her zaman sarımsı yeşil. Kutlama kartındaki mühür tek başına ana rengi izliyordu"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dấu kiểm luôn màu xanh lá non. Chỉ dấu trên thẻ chúc mừng còn theo màu chủ đạo"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对勾印章一直是黄绿色。只有祝贺卡片上的那个还跟着主色在变"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對勾印章一直是黃綠色。只有祝賀卡片上的那個還跟著主色在變"
          }
        }
      }
    },
    "체크 표시는 언제나 연두예요. 골랐다는 말은 원래 자기 색을 갖고 있어서, 키 컬러를 따라가지 않아요" : {
      "comment" : "Changelog 5.0.3 check green",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaškrtnutí je vždy žlutozelené. Volba má vlastní barvu, proto už nesleduje vaši hlavní barvu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flueben er altid lysegrønne. At vælge har sin egen farve, så den følger ikke længere din nøglefarve"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Häkchen sind immer gelbgrün. Eine Auswahl hat ihre eigene Farbe und folgt nicht mehr deiner Akzentfarbe"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα σημάδια επιλογής είναι πάντα λαχανί. Η επιλογή έχει δικό της χρώμα, γι' αυτό δεν ακολουθεί πια το βασικό σας χρώμα"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checkmarks are always yellow green. Saying yes has a color of its own, so it no longer follows your key color"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las marcas de verificación siempre son verde lima. Elegir tiene su propio color, así que ya no sigue tu color principal"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valintamerkit ovat aina limenvihreitä. Valinnalla on oma värinsä, joten se ei enää seuraa avainväriä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les coches sont toujours vert clair. Un choix a sa propre couleur, elles ne suivent donc plus la couleur principale"
          }
        },
        "id" : {
