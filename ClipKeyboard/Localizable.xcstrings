    "내용을 이어 더하면 스택가 돼요. 키보드에서 순서대로 입력됩니다." : {
      "comment" : "Continuation/combo explanation",
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidáním dalších kroků vznikne zásobník. Z klávesnice se zadají popořadě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj flere trin for at lave en stak. De indtastes i rækkefølge fra tastaturet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge weitere Schritte hinzu, dann wird es ein Stapel. Sie werden der Reihe nach über die Tastatur eingegeben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε περισσότερα βήματα για να γίνει στοίβα. Εισάγονται με τη σειρά από το πληκτρολόγιο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add more steps to make it a stack, they're entered in order from the keyboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si agregas más contenido, se vuelve una pila. Se escribe en orden desde el teclado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää vaiheita, niin tästä tulee Pino. Ne kirjoitetaan näppäimistöltä järjestyksessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez d'autres étapes pour créer une pile. Elles sont saisies dans l'ordre depuis le clavier."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah langkah lagi agar menjadi tumpukan. Langkahnya diketik berurutan dari keyboard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi altri passaggi per creare una pila: vengono inseriti in ordine dalla tastiera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内容を続けて追加するとスタックになります。キーボードから順に入力されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til flere trinn, så blir det en stabel. De skrives inn i rekkefølge fra tastaturet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg meer stappen toe voor een stapel. Ze worden op volgorde ingevoerd vanaf het toetsenbord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj kolejne kroki, a powstanie stos. Na klawiaturze wpisują się po kolei."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione mais passos para virar uma Pilha. Eles são digitados em ordem pelo teclado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляйте шаги дальше, и получится стопка. Они вводятся по порядку с клавиатуры."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till fler steg så blir det en stapel. De skrivs in i ordning från tangentbordet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มเนื้อหาต่อเพื่อให้เป็นสแตก จะพิมพ์ตามลำดับจากคีย์บอร์ด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha fazla adım eklerseniz yığın olur. Klavyede sırayla girilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm bước để thành ngăn xếp. Các bước được nhập lần lượt từ bàn phím."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "继续往下加内容就会变成短语堆，在键盘上会按顺序依次输入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "繼續往下加內容就會變成短語堆，在鍵盤上會按順序依次輸入。"
          }
        }
      }
