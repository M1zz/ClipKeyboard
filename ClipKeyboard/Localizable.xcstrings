          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定型文を追加すると、先に空きスペースができ、その上に作成画面が開きます。追加される場所がわかります"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du legger til en frase, dukker det først opp en tom plass, og redigeringen åpnes over den. Da ser du hvor den havner."
