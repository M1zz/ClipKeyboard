          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pega una nota completa de otra app y se divide en frases automáticamente"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liitä kokonainen teksti toisesta muistiinpanosovelluksesta, niin se jaetaan fraaseiksi"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collez une note entière depuis une autre app de notes, elle est répartie automatiquement en phrases"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempel seluruh catatan dari aplikasi lain, dan isinya otomatis dipecah menjadi frasa"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
