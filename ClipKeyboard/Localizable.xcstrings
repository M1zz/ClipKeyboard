    "Pick a visual direction for the app. Dusk uses a playful gradient-forward palette. Paper is warm and serif-led." : {
      "comment" : "Theme picker footer",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a visual direction for the app. Dusk uses a playful gradient-forward palette. Paper is warm and serif-led."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 비주얼 방향을 선택하세요. Dusk는 그라디언트 중심 · 인디고바이올렛. Paper는 웜톤 · 세리프 계열."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为 App 挑一个视觉风格。Dusk 是活泼的渐变配色，Paper 温暖，以衬线字体为主。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為 App 挑一個視覺風格。Dusk 是活潑的漸變配色，Paper 溫暖，以襯線字體為主。"
          }
        }
      },
      "shouldTranslate" : false
    },
