    "쓸 때마다 돌에 금이 가고, 세 번째에 깨지면서 보석이 나와요." : {
      "comment" : "Living skin description: geode",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každé použití kámen rozpraská, při třetím se rozlomí a objeví se drahokam."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver brug får stenen til at revne. Tredje gang brister den, og en ædelsten kommer frem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit jeder Nutzung bekommt der Stein Risse, beim dritten Mal bricht er auf und ein Edelstein kommt hervor."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με κάθε χρήση η πέτρα ραγίζει. Την τρίτη φορά σπάει και βγαίνει ένα πετράδι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each use cracks the stone; the third one breaks it open and a gem comes out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada uso agrieta la piedra; a la tercera se rompe y sale una gema."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokainen käyttökerta halkaisee kiveä, ja kolmas rikkoo sen: sisältä paljastuu jalokivi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque utilisation fissure la pierre ; la troisième l'ouvre et une gemme en sort."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap dipakai, batu retak. Pada kali ketiga batu pecah dan permata keluar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ogni uso la pietra si incrina, alla terza si spacca e ne esce una gemma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使うたびに石にひびが入り、3回目で割れて宝石が出てきます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver gang du bruker den, sprekker steinen. Ved tredje gang brekker den, og en edelsten kommer frem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij elk gebruik komt er een barst in de steen. Bij de derde breekt hij open en komt er een edelsteen uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z każdym użyciem kamień pęka, za trzecim razem rozpada się i pojawia się klejnot."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cada uso a pedra racha, e na terceira vez ela se abre e sai uma gema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С каждым использованием на камне появляется трещина. На третий раз он раскалывается, и появляется самоцвет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje användning spräcker stenen, och vid tredje gången går den sönder och en ädelsten kommer fram."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ทุกครั้ง หินจะร้าว ครั้งที่สามจะแตกออกและมีอัญมณีปรากฏ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her kullanımda taşa bir çatlak açılır, üçüncüde taş kırılır ve içinden bir mücevher çıkar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi lần dùng, viên đá nứt thêm. Đến lần thứ ba, đá vỡ ra và lộ một viên ngọc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每用一次石头就裂开一点，第三次裂开后会蹦出一颗宝石。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每用一次石頭就裂開一點，第三次裂開後會蹦出一顆寶石。"
          }
        }
      }
    },
    "쓸 때마다 여기만 갈아 끼워요" : {
      "comment" : "Template tutorial: role demo header",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
