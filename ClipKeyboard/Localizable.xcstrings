    "금액이나 수량처럼 매번 달라지는 값은 저장하지 않아요. 쓸 때 숫자판이 열립니다." : {
      "comment" : "Numeric placeholder explanation",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Částky a množství se pokaždé mění, proto se neukládají. Při použití se otevře číselná klávesnice."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beløb og antal ændrer sig hver gang, så de gemmes ikke. Taltastaturet åbner, når du bruger dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beträge und Mengen ändern sich jedes Mal und werden nicht gespeichert. Beim Einfügen öffnet sich der Ziffernblock."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ποσά και ποσότητες αλλάζουν κάθε φορά, επομένως δεν αποθηκεύονται. Το αριθμητικό πληκτρολόγιο ανοίγει όταν τα χρησιμοποιείτε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amounts and quantities change every time, so they are not saved. The number pad opens when you use it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los montos y las cantidades cambian cada vez, por eso no se guardan. Al usarlos se abre el teclado numérico."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Summia ja määriä ei tallenneta, koska ne vaihtelevat joka kerta. Numeronäppäimistö avautuu käytettäessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les montants et quantités changent à chaque fois, ils ne sont donc pas enregistrés. Le pavé numérique s'ouvre à l'utilisation."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jumlah dan kuantitas berubah setiap kali, jadi tidak disimpan. Papan angka terbuka saat Anda memakainya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importi e quantità cambiano ogni volta, quindi non vengono salvati. Il tastierino numerico si apre quando li usi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金額や数量のように毎回変わる値は保存しません。使うときにテンキーが開きます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beløp og antall endrer seg hver gang, så de lagres ikke. Talltastaturet åpnes når du bruker dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedragen en aantallen veranderen elke keer, dus ze worden niet bewaard. Het cijferpaneel opent als je het gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kwoty i ilości zmieniają się za każdym razem, więc nie są zapisywane. Przy użyciu otworzy się klawiatura numeryczna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valores e quantidades mudam toda vez, então não são salvos. O teclado numérico abre quando você usa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Такие значения, как сумма или количество, каждый раз разные, поэтому они не сохраняются. При использовании открывается цифровая клавиатура."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belopp och antal ändras varje gång, så de sparas inte. Sifferknappsatsen öppnas när du använder dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จำนวนเงินและจำนวนสินค้าจะเปลี่ยนทุกครั้ง จึงไม่ได้บันทึกไว้ แป้นตัวเลขจะเปิดขึ้นเมื่อใช้งาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutar ve adet gibi her seferinde değişen değerler kaydedilmez. Kullanırken sayı tuş takımı açılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số tiền và số lượng thay đổi mỗi lần nên không được lưu. Bàn phím số sẽ mở khi bạn dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金额、数量这类每次都不一样的值不会保存。使用时会弹出数字键盘。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金額、數量這類每次都不一樣的值不會儲存。使用時會彈出數字鍵盤。"
          }
        }
      }
    },
