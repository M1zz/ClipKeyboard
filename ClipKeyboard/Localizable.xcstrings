    "어림한 값이에요. 같은 문구를 잇달아 쓰면 찾아오는 시간은 한 번만 셉니다." : {
      "comment" : "Usage passport: grounds disclaimer",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jde o odhady. Použijete-li stejnou frázi dvakrát po sobě, vyhledání se započítá jen jednou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er skøn. Bruger du samme frase to gange i træk, tæller vi opslaget kun én gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das sind Schätzwerte. Nutzt du denselben Textbaustein direkt nacheinander, zählt das Suchen nur einmal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Είναι εκτιμήσεις. Αν χρησιμοποιήσετε την ίδια φράση δύο φορές στη σειρά, η αναζήτηση μετράει μόνο μία φορά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These are estimates. Use the same snippet twice in a row and we count the lookup only once."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son valores aproximados. Si usas la misma frase dos veces seguidas, el tiempo de búsqueda se cuenta una sola vez."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nämä ovat arvioita. Jos käytät samaa fraasia kahdesti peräkkäin, haun aika lasketaan vain kerran."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces valeurs sont approximatives. Si vous utilisez deux fois de suite la même phrase, la recherche n'est comptée qu'une fois."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini hanya perkiraan. Jika Anda memakai frasa yang sama dua kali berturut-turut, waktu pencarian hanya dihitung sekali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono stime. Se usi la stessa frase due volte di fila, contiamo il tempo di ricerca una sola volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目安の値です。同じ文を続けて使った場合、探す時間は1回だけ数えます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er anslag. Bruker du samme frase to ganger på rad, teller vi oppslaget bare én gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit zijn schattingen. Gebruik je hetzelfde fragment twee keer achter elkaar, dan tellen we het opzoeken maar één keer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To szacunki. Jeśli użyjesz tej samej frazy dwa razy z rzędu, czas wyszukania liczymy tylko raz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "São valores aproximados. Se você usar a mesma frase duas vezes seguidas, a busca é contada só uma vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это приблизительные значения. Если использовать одну фразу подряд несколько раз, поиск считается только один раз."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det är uppskattningar. Använder du samma fras två gånger i rad räknar vi uppslaget bara en gång."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เป็นค่าประมาณ หากใช้ข้อความด่วนเดิมติดกันสองครั้ง จะนับเวลาค้นหาเพียงครั้งเดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunlar tahmini değerlerdir. Aynı ifadeyi art arda kullanırsanız bulma süresi yalnızca bir kez sayılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây là số liệu ước tính. Nếu bạn dùng cùng một cụm từ hai lần liên tiếp, thời gian tìm chỉ được tính một lần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是估算值。连着用同一个短语时，找东西的时间只算一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是估算值。連著用同一個短語時，找東西的時間只算一次。"
          }
        }
      }
    },
