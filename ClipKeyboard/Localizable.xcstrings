        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipKeyboard가 시간을 아껴주거나 실수를 막아주는 18가지 순간."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
