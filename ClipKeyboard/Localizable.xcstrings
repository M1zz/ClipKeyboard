        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaa Safarista, niin se tallentuu heti fraasiksi. Sovelluksessa ei tarvitse tehdä mitään lisää"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
