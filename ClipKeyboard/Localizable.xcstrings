        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe {portapapeles} y ahí se pondrá lo que acabas de copiar. Por ejemplo: \"Tu número de guía es {portapapeles}\"."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{クリップボード} と書くと、その場所に今コピーしたものが入ります。「追跡番号は{クリップボード}です」のように使えます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напишите {буфер}, и туда попадёт то, что вы только что скопировали. Например: «Номер отслеживания: {буфер}»."
          }
