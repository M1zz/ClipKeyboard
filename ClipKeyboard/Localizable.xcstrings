        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα κουμπιά περιεχομένου χωρίστηκαν σε δύο. Η σάρωση κειμένου παίρνει μόνο τα γράμματα μιας φωτογραφίας, η προσθήκη εικόνας κρατά την ίδια τη φωτογραφία"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The content buttons are now two separate rows. Scan text in takes only the text from a photo; Attach an image keeps the photo itself"
